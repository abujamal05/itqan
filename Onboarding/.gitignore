# Rewritten as UTF-8. This file was saved as UTF-16 with a BOM, and git reads
# .gitignore as bytes, so not one rule in it was ever readable. That is why
# `dist/` is committed despite being listed here. Keep this file UTF-8.
#
# `dist/` is kept below because it was the evident intent, but note the built
# output is currently TRACKED: an ignore rule does not untrack anything, so it
# stays in the repo until it is removed from the index explicitly.
node_modules/
dist/
.env

# Playwright: browser binaries live in the user cache, but these run/output dirs
# are per-run artifacts and never belong in the repo.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
