# Copy to .env.local for local work. Vite only exposes VITE_-prefixed vars to
# the client, and inlines them at BUILD time — so changing one in Vercel needs a
# redeploy, not just a restart. Never put a secret in here: everything below
# ships inside the JavaScript bundle and is readable by anyone.

# ---------------------------------------------------------------- BACKEND --
# Where FastAPI lives.
#   local     http://localhost:8000/api   (or leave unset to use the dev plugin)
#   staging   https://api-staging.itqan.example/api
#   prod      https://api.itqan.example/api
# Unset means "/api" — same origin, which is what lets the auth cookies work
# with no CORS configuration at all. Prefer that: put FastAPI behind the same
# domain via a rewrite/proxy rather than a separate host.
# If you DO point this at another origin, the backend must send
# Access-Control-Allow-Credentials: true and an explicit origin (never "*"),
# or the browser silently drops the auth cookies and everything returns 401.
VITE_API_BASE_URL=

# Which deployment this build is. local | staging | production
VITE_ENVIRONMENT=local

# ---------------------------------------------------------------- TIMEOUTS --
# Normal request ceiling (ms).
VITE_REQUEST_TIMEOUT_MS=20000

# The synchronous A -> C -> E pipeline ceiling (ms). This one request runs OCR,
# several LLM calls and vector retrieval inline.
# IMPORTANT: this is the LAST timeout that applies. Every proxy in front of
# FastAPI has its own and most default to 60s (Vercel functions, nginx
# proxy_read_timeout, ALB idle timeout, Cloudflare). Raising this alone will not
# help if a gateway cuts the connection first.
VITE_ANALYSIS_TIMEOUT_MS=120000

# ------------------------------------------------------------------- SITE --
# The marketing site, which owns log in and sign up.
VITE_SITE_URL=https://itqan-site.vercel.app
