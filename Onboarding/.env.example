# Paddle. Without these the upgrade button renders disabled with an honest
# line rather than throwing, so a build with no billing configured is a valid
# state — see src/lib/paddle.ts.
#
# The client-side token is created in Paddle > Developer tools > Authentication.
# It is safe in the browser; the API key is NOT and must never appear here.
# The token's prefix and VITE_PADDLE_ENV have to agree: test_ with sandbox,
# live_ with production.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PADDLE_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxxx
