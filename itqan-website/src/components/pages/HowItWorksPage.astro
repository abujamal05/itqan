---
/**
 * How it works.
 *
 * The four steps as one continuous strap, in the same vocabulary the home page
 * introduces. Step two is the confirmation moment and is the only step given
 * extra weight, because it is where the product hands the decision back.
 *
 * Hud appears once, beside the confirmation step, where the product is asking
 * rather than concluding. He is fenced out of everything that states a finding.
 */
import Hud from '../Hud.astro';
import GirihField from '../GirihField.astro';
import GirihTile from '../GirihTile.astro';
import { type TileName } from '../../lib/girih';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

const stepTiles: TileName[] = ['decagon', 'pentagon', 'hexagon', 'bowtie'];
---

<section class="panel panel--navy on-navy hiw-head">
  <div class="panel__pattern reveal">
    <GirihField held={(row, col) => col + row < 8} radius={110} />
  </div>

  <div class="container panel__inner">
    <div class="page-head">
      <h1 class="title reveal">{s.hiw.title}</h1>
      <p class="page-head__intro reveal">{s.hiw.intro}</p>
    </div>
  </div>
</section>

<section class="panel panel--paper">
  <div class="container panel__inner">
    <ol class="spine">
      {
        s.hiw.steps.map((step, i) => (
          <li class="spine__step reveal">
            <span class="spine__marker">
              <GirihTile name={stepTiles[i]} state="set" size={30} />
            </span>
            <div>
              {i === 1 && (
                <p class="hiw__tag">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
                  {s.hiw.confirmTag}
                </p>
              )}
              <h2 class="spine__title">{step.title}</h2>
              <p class="spine__body">{step.body}</p>
              {i === 1 && (
                <div class="hiw__mascot">
                  <Hud pose="thinking" size="sm" loop />
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="panel panel--navy panel--closing on-navy">
  <div class="panel__pattern panel__pattern--centred" aria-hidden="true">
    <GirihField held={() => true} radius={120} />
  </div>
  <div class="container panel__inner closing">
    <h2 class="heading reveal">{s.home.closing.heading}</h2>
    <div class="actions">
      <a class="button button--primary button--arrow" href={`${base}/signup/`}>
        <span>{s.actions.signup}</span>
        <svg class="button__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hiw-head {
    padding-block: 0;
  }

  /* The confirmation step is the product's first trust moment. It gets a label,
     which no other step does, rather than a box that separates it from the
     sequence it belongs to. */
  .hiw__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-block-end: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .hiw__mascot {
    margin-block-start: var(--space-6);
  }
</style>
