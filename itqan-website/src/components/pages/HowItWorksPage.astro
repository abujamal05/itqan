---
import { Icon } from 'astro-icon/components';
import Hud from '../Hud.astro';
import Shot from '../Shot.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

const stepIcons = [
  'ph:file-text-duotone',   // you bring what you have
  'ph:seal-check-duotone',  // you confirm what it read
  'ph:target-duotone',      // you choose the role
  'ph:path-duotone',        // you get the path and the jobs
];
---

<div class="container">
  <header class="page-head reveal">
    <p class="eyebrow">{s.hiw.eyebrow}</p>
    <h1>{s.hiw.title}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
    <p class="page-head__intro">{s.hiw.intro}</p>
  </header>

  <ol class="hiw">
    <span class="hiw__thread reveal" aria-hidden="true"></span>
    {
      s.hiw.steps.map((step, i) => (
        <li class:list={['hiw__step', 'reveal', { 'hiw__step--confirm': i === 1 }]}>
          <div class="hiw__marker">
            <span class="hiw__node">
              <Icon name={stepIcons[i]} width="28" height="28" aria-hidden="true" />
            </span>
          </div>
          <div class="hiw__body">
            <div class="hiw__text">
              <div class="hiw__meta">
                <span class="hiw__step-num">{i + 1}</span>
                {
                  i === 1 && (
                    <span class="hiw__tag">
                      <Icon name="ph:check" width="13" height="13" aria-hidden="true" />
                      {s.hiw.confirmTag}
                    </span>
                  )
                }
              </div>
              <h2>{step.title}</h2>
              <p class="hiw__step-body">{step.body}</p>
            </div>
            {/* Real product screens, not grey placeholder boxes: the page is
                describing four steps and can simply show three of them.

                Exactly ONE mascot, on step two. Steps two and three used to
                carry one each and they are adjacent in a vertical timeline, so
                both were on screen together at every desktop height. Step two
                keeps him because it is the confirmation moment, where the
                product is asking rather than concluding. */}
            <div class="hiw__visual">
              {i === 0 && <Shot name="upload" alt={s.hiw.steps[0].body} />}
              {i === 1 && <Hud pose="thinking" size="md" loop />}
              {i === 2 && <Shot name="questions-role" alt={s.hiw.steps[2].body} />}
              {i === 3 && <Shot name="jobs" alt={s.hiw.steps[3].body} />}
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="page-cta reveal">
    <a class="button button--primary button--arrow" href={`${base}/signup/`}>
      <span>{s.actions.signup}</span>
      <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
    </a>
  </div>
</div>

<style>
  /* .page-head now lives in global.css. */

  /* ---- Vertical timeline with the drawn gold thread ---- */
  .hiw {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* The spine runs down the node centres and draws from the top on reveal. */
  .hiw__thread {
    position: absolute;
    inset-block: 28px;
    inset-inline-start: 27px;
    inline-size: 3px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    transform: scaleY(1);
    transform-origin: 50% 0;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global(html.reveal-ready) .hiw__thread.reveal:not(.is-visible) {
    transform: scaleY(0);
  }

  .hiw__step {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    column-gap: var(--space-6);
    align-items: start;
  }

  .hiw__node {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 56px;
    block-size: 56px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
    box-shadow: 0 0 0 6px var(--color-bg);
  }

  .hiw__body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    padding-block-start: var(--space-1);
  }

  .hiw__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hiw__step-num {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-ink);
  }

  /* Marks the confirmation step as the trust moment without boxing it alone. */
  .hiw__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .hiw__text h2 {
    margin-block: var(--space-2) var(--space-3);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  .hiw__step-body {
    color: var(--color-text-muted);
    line-height: 1.6;
    max-inline-size: 52ch;
  }

  .hiw__visual {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 51.99rem) {
    .hiw__step {
      grid-template-columns: 44px minmax(0, 1fr);
      column-gap: var(--space-4);
    }
    .hiw__node {
      inline-size: 44px;
      block-size: 44px;
    }
    .hiw__thread {
      inset-inline-start: 21px;
      inset-block: 22px;
    }
    .hiw__body {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  .page-cta {
    padding-block: var(--space-16);
    display: flex;
    justify-content: center;
  }
</style>
