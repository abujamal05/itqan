---
import Hud from '../Hud.astro';
import Placeholder from '../Placeholder.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

const stepIcons = [
  'M12 15V4M8 8l4-4 4 4M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3', // share: upload
  'M4 12.5l4.5 4.5L20 5.5', // confirm: check
  'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM12 11.5v.01', // match: target
  'M4 13l3.5 3.5L14 10M14 6h6M14 11h6M14 16h4', // gaps: plan/list
];
---

<div class="container">
  <header class="page-head reveal">
    <p class="eyebrow">{s.hiw.eyebrow}</p>
    <h1>{s.hiw.title}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
    <p class="page-head__intro">{s.hiw.intro}</p>
  </header>

  <ol class="hiw">
    <span class="hiw__thread reveal" aria-hidden="true"></span>
    {
      s.hiw.steps.map((step, i) => (
        <li class:list={['hiw__step', 'reveal', { 'hiw__step--confirm': i === 1 }]}>
          <div class="hiw__marker">
            <span class="hiw__node">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={stepIcons[i]} />
              </svg>
            </span>
          </div>
          <div class="hiw__body">
            <div class="hiw__text">
              <div class="hiw__meta">
                <span class="hiw__step-num">{i + 1}</span>
                {
                  i === 1 && (
                    <span class="hiw__tag">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
                      {s.hiw.confirmTag}
                    </span>
                  )
                }
              </div>
              <h2>{step.title}</h2>
              <p class="hiw__step-body">{step.body}</p>
            </div>
            <div class="hiw__visual">
              {i === 0 && <Placeholder label={s.ph.stepShare} width={640} height={480} />}
              {i === 1 && <Hud pose="thinking" size="md" loop />}
              {i === 2 && <Hud pose="analyzing" size="md" loop />}
              {i === 3 && <Placeholder label={s.ph.stepPlan} width={640} height={480} />}
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="page-cta reveal">
    <a class="button button--primary button--arrow" href={`${base}/signup/`}>
      <span>{s.actions.signup}</span>
      <svg class="button__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
    </a>
  </div>
</div>

<style>
  .page-head {
    padding-block: var(--space-20) var(--space-12);
    max-inline-size: 46rem;
  }

  .page-head h1 {
    margin-block-start: var(--space-4);
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }

  .page-head__rule {
    margin-block-start: var(--space-6);
    inline-size: var(--space-16);
    block-size: 4px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    transform: scaleX(1);
    transform-origin: 0 50%;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global([dir='rtl']) .page-head__rule {
    transform-origin: 100% 50%;
  }

  :global(html.reveal-ready) .page-head.reveal:not(.is-visible) .page-head__rule {
    transform: scaleX(0);
  }

  .page-head__intro {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 51.99rem) {
    .page-head {
      padding-block: var(--space-12) var(--space-8);
    }
    .page-head h1 {
      font-size: var(--text-4xl);
    }
  }

  /* ---- Vertical timeline with the drawn gold thread ---- */
  .hiw {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* The spine runs down the node centres and draws from the top on reveal. */
  .hiw__thread {
    position: absolute;
    inset-block: 28px;
    inset-inline-start: 27px;
    inline-size: 3px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    transform: scaleY(1);
    transform-origin: 50% 0;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global(html.reveal-ready) .hiw__thread.reveal:not(.is-visible) {
    transform: scaleY(0);
  }

  .hiw__step {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    column-gap: var(--space-6);
    align-items: start;
  }

  .hiw__node {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 56px;
    block-size: 56px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
    box-shadow: 0 0 0 6px var(--color-bg);
  }

  .hiw__body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    padding-block-start: var(--space-1);
  }

  .hiw__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hiw__step-num {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-hover);
  }

  /* Marks the confirmation step as the trust moment without boxing it alone. */
  .hiw__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .hiw__text h2 {
    margin-block: var(--space-2) var(--space-3);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  .hiw__step-body {
    color: var(--color-text-muted);
    line-height: 1.6;
    max-inline-size: 52ch;
  }

  .hiw__visual {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 51.99rem) {
    .hiw__step {
      grid-template-columns: 44px minmax(0, 1fr);
      column-gap: var(--space-4);
    }
    .hiw__node {
      inline-size: 44px;
      block-size: 44px;
    }
    .hiw__thread {
      inset-inline-start: 21px;
      inset-block: 22px;
    }
    .hiw__body {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  .page-cta {
    padding-block: var(--space-16);
    display: flex;
    justify-content: center;
  }
</style>
