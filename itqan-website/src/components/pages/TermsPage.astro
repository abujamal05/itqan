---
import NoticeBox from '../NoticeBox.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<div class="container legal">
  <header class="page-head reveal">
    <p class="eyebrow">{s.terms.eyebrow}</p>
    <h1>{s.terms.heading}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
  </header>

  {/* UNDER CONSTRUCTION, and nothing more.
      There is no drafted terms text, and a page that summarises terms it does
      not have reads as terms. `s.terms.body` stays in the locale files as the
      brief for whoever drafts the real thing, but it is not rendered: a plain
      sentence about the service is not a term of use, and putting it under this
      heading invites someone to treat it as one. */}
  <NoticeBox>
    <p>{s.terms.notice}</p>
  </NoticeBox>
</div>

<style>
  .legal {
    max-inline-size: 44rem;
    padding-block-end: var(--space-20);
  }

  /* .page-head now lives in global.css. */
</style>
