---
import NoticeBox from '../NoticeBox.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<div class="container legal">
  <header class="page-head reveal">
    <p class="eyebrow">{s.terms.eyebrow}</p>
    <h1>{s.terms.heading}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
  </header>

  <NoticeBox>
    <p>{s.terms.notice}</p>
  </NoticeBox>

  <p class="legal__body">{s.terms.body}</p>
</div>

<style>
  .legal {
    max-inline-size: 44rem;
    padding-block-end: var(--space-20);
  }

  /* .page-head now lives in global.css. */

  .legal__body {
    margin-block-start: var(--space-8);
    font-size: var(--text-lg);
  }
</style>
