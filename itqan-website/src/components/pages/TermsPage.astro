---
/* THE PUBLISHED TERMS. Same reasoning as PrivacyPage: this renders the
   agreement itself rather than a description of one plus a notice saying the
   real thing is coming. Structure and styling are deliberately identical to
   the privacy page, because the two are read as a pair and a reader who has
   learned to scan one should not have to learn the other. */
import { t, type Locale } from '../../i18n';
import { bidiParts } from '../../lib/bidi';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<div class="container legal">
  <header class="page-head" data-enter>
    <p class="eyebrow">{s.terms.effective}</p>
    <h1>{s.terms.heading}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
    <p class="page-head__intro">{s.terms.intro}</p>
  </header>

  <div class="legal__body">
    {
      s.terms.sections.map((section) => (
        <section class="legal__section reveal">
          <h2>{section.heading}</h2>
          {section.points.map((point) => (
            <p>
              {/* Latin runs are isolated so a domain or an address cannot
                  drag the surrounding Arabic punctuation around it. */}
              {bidiParts(point).map((part) => (part.latin ? <bdi>{part.text}</bdi> : part.text))}
            </p>
          ))}
        </section>
      ))
    }
  </div>
</div>

<style>
  .legal {
    max-inline-size: 44rem;
    padding-block-end: var(--space-20);
  }

  .legal__body {
    display: grid;
    gap: var(--space-10);
    margin-block: var(--space-12);
  }

  .legal__section h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    margin-block-end: var(--space-4);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--color-border-accent);
  }

  .legal__section p {
    line-height: 1.7;
    margin-block: 0 var(--space-4);
  }

  .legal__section p:last-child {
    margin-block-end: 0;
  }

  /* .page-head now lives in global.css. */
</style>
