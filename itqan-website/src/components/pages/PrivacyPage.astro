---
/* Structure only. The legal text is written by a lawyer; fabricating a
   privacy notice in a regulated market would be worse than an empty one. */
import NoticeBox from '../NoticeBox.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<div class="container legal">
  <header class="page-head reveal">
    <p class="eyebrow">{s.privacy.eyebrow}</p>
    <h1>{s.privacy.heading}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
    <p class="page-head__intro">{s.privacy.intro}</p>
  </header>

  {
    s.privacy.sections.map((section) => (
      <section class="legal-section">
        <h2>{section.heading}</h2>
        <NoticeBox>
          <p>{s.privacy.noticeLabel}</p>
          <ul>
            {section.questions.map((q) => (
              <li>{q}</li>
            ))}
          </ul>
        </NoticeBox>
      </section>
    ))
  }
</div>

<style>
  .legal {
    max-inline-size: 44rem;
    padding-block-end: var(--space-16);
  }

  .page-head {
    padding-block: var(--space-20) var(--space-10);
  }

  .page-head h1 {
    margin-block-start: var(--space-4);
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }

  .page-head__rule {
    margin-block-start: var(--space-6);
    inline-size: var(--space-16);
    block-size: 4px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    transform: scaleX(1);
    transform-origin: 0 50%;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global([dir='rtl']) .page-head__rule {
    transform-origin: 100% 50%;
  }

  :global(html.reveal-ready) .page-head.reveal:not(.is-visible) .page-head__rule {
    transform: scaleX(0);
  }

  .page-head__intro {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 51.99rem) {
    .page-head {
      padding-block: var(--space-12) var(--space-8);
    }
    .page-head h1 {
      font-size: var(--text-4xl);
    }
  }

  .legal-section {
    margin-block-end: var(--space-10);
  }

  .legal-section h2 {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-4);
  }

  .legal-section ul {
    margin: var(--space-2) 0 0;
    padding-inline-start: var(--space-5);
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
</style>
