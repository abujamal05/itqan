---
/* THE PUBLISHED POLICY. This page used to render a description of what the
   software does plus a notice saying the real notice was still with a lawyer.
   It now renders the policy itself, and there is no draft notice, because a
   document that keeps apologising for not being finished is not one anybody
   can rely on.

   PARAGRAPHS, NOT BULLETS. The previous version set every point as a list item
   with an accent hairline, which reads well for six short statements and badly
   for fourteen sections of prose. Legal text is read in order and in full; the
   job of the layout is to keep the measure short and the headings findable, not
   to decorate each sentence.

   The lawyer's question list survives as `s.privacy.brief` in the locale files
   and is deliberately not rendered. */
import { t, type Locale } from '../../i18n';
import { bidiParts } from '../../lib/bidi';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<div class="container legal">
  <header class="page-head" data-enter>
    <p class="eyebrow">{s.privacy.effective}</p>
    <h1>{s.privacy.heading}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
    <p class="page-head__intro">{s.privacy.intro}</p>
  </header>

  <div class="legal__body">
    {
      s.privacy.sections.map((section) => (
        <section class="legal__section reveal">
          <h2>{section.heading}</h2>
          {section.points.map((point) => (
            <p>
              {/* Latin runs are isolated so a domain or an address cannot
                  drag the surrounding Arabic punctuation around it. */}
              {bidiParts(point).map((part) => (part.latin ? <bdi>{part.text}</bdi> : part.text))}
            </p>
          ))}
        </section>
      ))
    }
  </div>
</div>

<style>
  .legal {
    max-inline-size: 44rem;
    padding-block-end: var(--space-20);
  }

  .legal__body {
    display: grid;
    gap: var(--space-10);
    margin-block: var(--space-12);
  }

  .legal__section h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    margin-block-end: var(--space-4);
    /* The one accent on the page, and it is structural: a reader scanning for
       "how long do they keep it" is looking for the headings, not the prose. */
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--color-border-accent);
  }

  .legal__section p {
    line-height: 1.7;
    margin-block: 0 var(--space-4);
  }

  .legal__section p:last-child {
    margin-block-end: 0;
  }

  /* .page-head now lives in global.css. */
</style>
