---
/* Structure only. The legal text is written by a lawyer; fabricating a
   privacy notice in a regulated market would be worse than an empty one. */
import NoticeBox from '../NoticeBox.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<div class="container legal">
  <header class="page-head reveal">
    <h1 class="title">{s.privacy.heading}</h1>
  </header>

  {/* UNDER CONSTRUCTION, and nothing more.
      This used to publish the lawyer's own question list, section by section, on
      the live page. That reads to a visitor as a privacy notice with the answers
      missing, which is worse than saying nothing: it puts the gaps on display
      under a heading people arrive at precisely because they want certainty.
      `s.privacy.sections` and `noticeLabel` stay in the locale files as the
      brief for whoever drafts the real notice. */}
  <NoticeBox>
    <p>{s.privacy.intro}</p>
  </NoticeBox>
</div>

<style>
  .legal {
    max-inline-size: 44rem;
    padding-block-end: var(--space-16);
  }

  /* .page-head now lives in global.css. */
</style>
