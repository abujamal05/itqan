---
/**
 * Password recovery, by email verification.
 *
 * ONE route, three panels, chosen by the URL:
 *
 *   /forgot-password/            ask for the email
 *   (after a successful POST)    "check your email", in place
 *   /forgot-password/?token=…    set a new password
 *
 * One route rather than three because the middle state is not a page: it is the
 * answer to the form that was just submitted, and navigating away from a form to
 * say "we heard you" loses the address they typed if they need to correct it.
 *
 * NOT LINKED FROM ANYWHERE YET, on purpose. The flow is complete on this side
 * but the backend cannot send an email, and a recovery page that silently does
 * nothing is worse than none: the person using it has already lost access and
 * will wait for a message that never comes. The link stays out of the login page
 * until the endpoints in §"What the backend must provide" below exist.
 *
 * SECURITY NOTE, and the reason the success copy is worded the way it is: the
 * response never says whether an account exists. "If that address has an
 * account, a link is on its way" is the same answer either way, so the form
 * cannot be used to discover who is registered. The backend must match that:
 * always 200, always the same body, and the same timing.
 */
import { Icon } from 'astro-icon/components';
import Hud from '../Hud.astro';
import { t, type Locale } from '../../i18n';
/* THE MISSING IMPORT. Login and signup both pull this in; this page never did,
   so every `.form-card`, `.field` and `.field__check` rule it uses was inert.
   The result was a bare browser-default input on the page background with no
   card around it, and the validation tick — which is `display: none` until
   `[data-state='valid']` — sitting permanently visible under the field. */
import '../../styles/forms.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;
---

<div class="container auth">
  {/* Request. Hidden immediately by the inline script when a token is present,
      so a person following the emailed link never sees it flash. */}
  <section class="auth__panel" data-panel="request">
    {/* Hud sits at the inline start, exactly as he does on log in and sign up,
        so the three pages of one flow share a composition instead of each
        inventing its own. He is decoration and aria-hidden, so `order` moves
        him ahead of the form visually while the form stays first in the DOM
        for keyboard and screen reader users — and being logical, `order`
        mirrors itself in Arabic. */}
    <div class="auth__figure">
      <Hud pose="waving" size="md" loop />
    </div>

    <div class="auth__body">
      <header class="page-head">
        <h1>{s.forgot.heading}</h1>
        <p class="auth__sub">{s.forgot.sub}</p>
      </header>

    <form
      class="form-card auth-form"
      id="forgot-form"
      method="post"
      action="/api/auth/forgot-password"
      novalidate
      data-server-error={s.forgot.serverError}
    >
      <div class="form-summary" role="alert" tabindex="-1" hidden>
        <Icon class="form-summary__icon" name="ph:warning-duotone" width="22" height="22" aria-hidden="true" />
        <div>
          <p class="form-summary__heading">{s.forgot.summaryHeading}</p>
          <ul class="form-summary__list"></ul>
        </div>
      </div>

      <div
        class="field"
        data-msg-required={s.forgot.email.errorRequired}
        data-msg-format={s.forgot.email.errorFormat}
      >
        <label for="fp-email">{s.forgot.email.label}</label>
        <div class="field__control">
          <input
            id="fp-email"
            name="email"
            type="email"
            autocomplete="email"
            dir="ltr"
            required
            aria-describedby="fp-email-error"
          />
          <span class="field__check" aria-hidden="true">
            <Icon name="ph:check" width="16" height="16" aria-hidden="true" />
          </span>
        </div>
        <p class="field__error" id="fp-email-error" hidden>
          <Icon name="ph:warning-circle" width="16" height="16" aria-hidden="true" />
          <span class="field__error-text"></span>
        </p>
      </div>

      <button class="button button--primary form-submit" type="submit">
        <span class="spinner" aria-hidden="true"></span>
        <span class="form-submit__label">{s.forgot.submit}</span>
      </button>
    </form>

      <p class="auth__alt">
        <a href={`${base}/login/`}>{s.forgot.back}</a>
      </p>
    </div>
  </section>

  {/* Sent. Announced politely so a screen reader hears the outcome without
      losing the place in the form.
      This is the one genuinely good moment in a recovery — something is on its
      way — so it is the one panel that takes the warm ground the design system
      reserves for reassurance, rather than the same white card as the form it
      replaced. */}
  <section class="auth__panel" data-panel="sent" hidden>
    <div class="auth__figure">
      <Hud pose="waving" size="md" loop />
    </div>

    <div class="auth__body">
      <header class="page-head">
        <h1>{s.forgot.sentHeading}</h1>
      </header>
      <div class="form-card form-card--warm" role="status" aria-live="polite">
        <div class="stack">
          <p>{s.forgot.sentBody}</p>
          <p class="auth__hint">{s.forgot.sentSpam}</p>
        </div>
      </div>
      <p class="auth__alt">
        <a href={`${base}/login/`}>{s.forgot.back}</a>
      </p>
    </div>
  </section>

  {/* Reset. Reached only from the emailed link.
      NO mascot here, deliberately. This is the one panel where the user is
      typing a credential, and the screen should hold their whole attention on
      the field and its strength rule — a character waving beside it is a
      distraction on the only security-critical step in the flow. */}
  <section class="auth__panel auth__panel--solo" data-panel="reset" hidden>
    <div class="auth__body">
      <header class="page-head">
        <h1>{s.forgot.resetHeading}</h1>
        <p class="auth__sub">{s.forgot.resetSub}</p>
      </header>

    <form
      class="form-card auth-form"
      id="reset-form"
      method="post"
      action="/api/auth/reset-password"
      novalidate
      data-server-error={s.forgot.serverError}
      data-msg-weak={s.signup.password.errorWeak}
      data-success-url={`${base}/login/`}
    >
      <div class="form-summary" role="alert" tabindex="-1" hidden>
        <Icon class="form-summary__icon" name="ph:warning-duotone" width="22" height="22" aria-hidden="true" />
        <div>
          <p class="form-summary__heading">{s.forgot.summaryHeading}</p>
          <ul class="form-summary__list"></ul>
        </div>
      </div>

      {/* Filled by the inline script from the URL, then the URL is cleaned so
          the token cannot be leaked by a shared link or a referer header. */}
      <input type="hidden" name="token" id="rp-token" value="" />

      <div
        class="field"
        data-check="password"
        data-msg-required={s.signup.password.error}
        data-msg-minlength={s.signup.password.error}
        data-msg-weak={s.signup.password.errorWeak}
      >
        <label for="rp-password">{s.forgot.newPassword.label}</label>
        <span class="field__hint">{s.signup.password.hint}</span>
        <div class="field__control">
          <input
            id="rp-password"
            name="password"
            type="password"
            autocomplete="new-password"
            dir="ltr"
            required
            minlength="8"
            aria-describedby="rp-password-error"
          />
          <button
            type="button"
            class="field__reveal"
            data-reveal
            aria-controls="rp-password"
            aria-pressed="false"
            aria-label={s.a11y.showPassword}
            data-label-show={s.a11y.showPassword}
            data-label-hide={s.a11y.hidePassword}
          >
            <Icon class="field__reveal-on" name="ph:eye" width="18" height="18" aria-hidden="true" />
            <Icon class="field__reveal-off" name="ph:eye-slash" width="18" height="18" aria-hidden="true" />
          </button>
          <span class="field__check" aria-hidden="true">
            <Icon name="ph:check" width="16" height="16" aria-hidden="true" />
          </span>
        </div>
        <p class="field__error" id="rp-password-error" hidden>
          <Icon name="ph:warning-circle" width="16" height="16" aria-hidden="true" />
          <span class="field__error-text"></span>
        </p>
      </div>

      <button class="button button--primary form-submit" type="submit">
        <span class="spinner" aria-hidden="true"></span>
        <span class="form-submit__label">{s.forgot.resetSubmit}</span>
      </button>
    </form>
    </div>
  </section>

  {/* Dead link. Its own panel because the recovery is genuinely over and the
      only useful action is to start again, not to retype a password.
      Hud takes the `error` pose here — the fence allows him on an error state,
      and a link expiring is the product's fault to explain, not the user's
      mistake to be scolded for. */}
  <section class="auth__panel" data-panel="expired" hidden>
    <div class="auth__figure">
      <Hud pose="error" size="md" loop />
    </div>

    <div class="auth__body">
      <header class="page-head">
        <h1>{s.forgot.expiredHeading}</h1>
      </header>
      <div class="form-card">
        <div class="stack">
          <p>{s.forgot.expiredBody}</p>
          <div class="row">
            <a class="button button--primary" href={`${base}/forgot-password/`}>{s.forgot.expiredCta}</a>
          </div>
        </div>
      </div>
      <p class="auth__alt">
        <a href={`${base}/login/`}>{s.forgot.back}</a>
      </p>
    </div>
  </section>

</div>

<script>
  import { initForm } from '../../scripts/form';

  /* Validation, the loading state and the submit fetch all come from the shared
     script, the same as login and signup. Without this the forms would post
     natively and skip every message they define. */
  document
    .querySelectorAll<HTMLFormElement>('form.form-card')
    .forEach((form) => initForm(form));

  /**
   * Panel routing and token handling.
   *
   * Runs before the form script binds anything, and synchronously, so the
   * request form never flashes for someone arriving from the emailed link.
   */
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  const show = (name: string) => {
    panels.forEach((p) => { p.hidden = p.dataset.panel !== name; });
  };

  /* Where the token lives between the address bar and the form.
   *
   * It cannot stay in the URL (see below) and it cannot stay in the page,
   * because switching language is a full navigation to the other route tree.
   * Without somewhere to keep it, a person who arrives from the emailed link and
   * then switches language lands on a page with no token and is sent back to
   * "enter your email" — with a link they can only use once.
   *
   * sessionStorage is the right shape for it: same-origin, tab-scoped, gone when
   * the tab closes, and — unlike the URL it replaces — absent from history, from
   * anything pasted, and from the Referer. It grants nothing new either; script
   * that could read it can already read the hidden field below. */
  const STASH = 'itqan.reset-token';
  const stash = {
    get(): string | null {
      try { return sessionStorage.getItem(STASH); } catch { return null; }
    },
    set(value: string) {
      try { sessionStorage.setItem(STASH, value); } catch { /* private mode */ }
    },
    clear() {
      try { sessionStorage.removeItem(STASH); } catch { /* private mode */ }
    },
  };

  const url = new URL(window.location.href);
  /* The URL first, so a freshly clicked link always wins over a stale stash —
     someone who requests a second link and opens it in the same tab must reset
     with the new token, not the one it replaced. */
  const token = url.searchParams.get('token') ?? stash.get();

  if (token) {
    const field = document.getElementById('rp-token') as HTMLInputElement | null;
    if (field) field.value = token;
    show('reset');
    stash.set(token);
    /* The token is a credential. Taking it out of the address bar keeps it out
       of the history, out of anything the user might paste, and out of the
       Referer header on any later request from this page. */
    url.searchParams.delete('token');
    window.history.replaceState({}, '', url.pathname + url.search + url.hash);
  }

  /**
   * The request form answers in place rather than navigating: the "check your
   * email" state belongs to the address just typed, and a new page would lose
   * it if they mistyped and need to try again.
   *
   * It has no data-success-url, which is what tells the shared form script to
   * leave the navigation alone; the listener below runs after its validation
   * has passed and its fetch has resolved.
   */
  const forgot = document.getElementById('forgot-form') as HTMLFormElement | null;
  forgot?.addEventListener('itqan:submitted', ((e: CustomEvent<{ ok: boolean }>) => {
    /* Shown for ANY outcome that is not a network failure, including an address
       with no account. Saying "no such account" here would turn the form into a
       way to discover who is registered. */
    if (e.detail.ok) show('sent');
  }) as EventListener);

  /**
   * A rejected token is not a validation error, it is the end of the attempt,
   * so it swaps the panel instead of writing a message under the field.
   */
  const reset = document.getElementById('reset-form') as HTMLFormElement | null;
  reset?.addEventListener('itqan:submitted', ((e: CustomEvent<{ ok: boolean; status: number }>) => {
    if (e.detail.ok) {
      /* Spent. Keeping it would leave a dead token in the tab, and a later visit
         to this page would open the reset panel for a link that cannot work. */
      stash.clear();
      return;
    }
    if (e.detail.status === 400 || e.detail.status === 410) {
      /* Rejected — expired, already used, or mangled. Same reasoning: the panel
         that follows offers a fresh link, and a stale token must not survive to
         pre-empt it. */
      stash.clear();
      show('expired');
      return;
    }
    if (e.detail.status === 422) {
      /* The password itself was refused, and this is the one failure here the
         person can fix without a new link — so it belongs UNDER THE FIELD, as a
         validation error, not in a panel about expired links and not as
         "something went wrong, try again in a moment", which would tell them to
         wait for a condition that will never change on its own.

         The client checks the same rule before posting, so reaching this means
         the two have drifted apart. Saying which rule was broken is still the
         useful thing; saying nothing leaves a correct-looking password refused
         with no reason. */
      e.preventDefault();
      const field = document.getElementById('rp-password')?.closest('.field') as HTMLElement | null;
      const box = document.getElementById('rp-password-error');
      const text = box?.querySelector<HTMLElement>('.field__error-text');
      if (field && box && text) {
        field.dataset.state = 'error';
        text.textContent = reset?.dataset.msgWeak ?? '';
        box.hidden = false;
        document.getElementById('rp-password')?.focus();
      }
    }
  }) as EventListener);
</script>

<style>
  /* The container no longer caps its own width — each PANEL does, so the
     mascot column sits outside the reading measure instead of stealing from
     it. Was a bare 32rem cap with the form left aligned inside it and the
     "back to log in" link centred underneath, so nothing on the page agreed
     on an edge. */
  .auth {
    padding-block-end: var(--space-20);
  }

  /* One composition for every panel, and the same one log in and sign up use:
     mascot at the inline start, content beside it, the pair centred.

     `:not([hidden])` is load-bearing, not tidiness. The `hidden` attribute
     works through the UA rule `[hidden] { display: none }`, which carries
     almost no specificity — so a bare `.auth__panel[data-panel]` display rule
     (0,2,0) silently overrode it and rendered ALL FOUR panels stacked down the
     page at once. Anything that sets `display` on an element that can be
     `hidden` has to exclude it. */
  .auth__panel[data-panel]:not([hidden]) {
    display: flex;
    gap: var(--space-12);
    align-items: center;
    justify-content: center;
  }

  /* `order`, not markup order: the form stays first in the DOM so keyboard and
     screen reader users reach it immediately, while Hud — decoration, and
     aria-hidden — renders ahead of it. Logical, so it mirrors in Arabic
     without a second rule. */
  .auth__figure {
    order: -1;
    flex: 0 0 auto;
  }

  .auth__body {
    flex: 0 1 32rem;
    inline-size: 100%;
  }

  /* The reset step has no mascot, so its column carries the page alone. */
  .auth__panel--solo .auth__body {
    flex-basis: 34rem;
  }

  .page-head {
    padding-block: var(--space-16) var(--space-6);
  }

  .page-head h1 {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }

  .auth__sub {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Aligned with the card above it, not centred. The centred version was the
     only element on the page not sharing the form's inline edge. */
  .auth__alt {
    margin-block-start: var(--space-6);
  }

  .auth__hint {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* The "on its way" card. The one reassuring moment in a recovery, so it
     takes the warm ground the system reserves for exactly that rather than
     repeating the white card of the form it just replaced. --gold-700 keeps
     the edge readable; the brand gold measures 2:1 on paper and is barred from
     carrying a meaningful border on light. */
  .form-card--warm {
    background-color: var(--color-surface-warm);
    border-color: var(--color-border-accent);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Phones: the mascot moves under the content rather than squeezing it, and
     the vertical rhythm tightens. */
  @media (max-width: 51.99rem) {
    .auth__panel[data-panel] {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-8);
    }

    .auth__figure {
      order: 0;
      align-self: center;
    }

    .page-head {
      padding-block: var(--space-10) var(--space-5);
    }
  }
</style>
