---
import { Icon } from 'astro-icon/components';
import Hud from '../Hud.astro';
import { t, type Locale } from '../../i18n';
import { formEndpoints, appUrl } from '../../config';
import '../../styles/forms.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;
---

<div class="container auth">
  <div class="auth__main">
    <p class="eyebrow">{s.login.eyebrow}</p>
    <h1>{s.login.heading}</h1>

    <form
      class="form-card"
      method="post"
      action={formEndpoints.login}
      novalidate
      data-server-error={s.login.serverError}
      {/* The shared refusals, rendered here because this script cannot read the
      locale: a string baked into the bundle would be English on an Arabic
      page. See `serverErrorMessage` — the page's own `data-server-error`
      stays the last resort. */}
      data-err-network={s.err.network}
      data-err-server={s.err.server}
      data-err-session={s.err.session}
      data-err-credentials={s.err.credentials}
      data-err-email-taken={s.err.emailTaken}
      data-err-unverified={s.err.unverified}
      data-err-consent-required={s.err.consentRequired}
      data-err-invalid-code={s.err.invalidCode}
      data-err-code-expired={s.err.codeExpired}
      data-err-invalid-input={s.err.invalidInput}
      data-err-not-found={s.err.notFound}
      data-err-rate-limited={s.err.rateLimited}
      data-err-rate-limited-in={s.err.rateLimitedIn}
      data-msg-invalid={s.login.invalidCredentials}
      data-forgot-url={`${base}/forgot-password/`}
      data-forgot-text={s.login.forgot}
      data-success-url={appUrl}
    >
      <div class="form-summary" role="alert" tabindex="-1" hidden>
        <Icon class="form-summary__icon" name="ph:warning-duotone" width="22" height="22" aria-hidden="true" />
        <div>
          <p class="form-summary__heading">{s.login.summaryHeading}</p>
          <ul class="form-summary__list"></ul>
        </div>
      </div>

      <div class="field" data-msg-required={s.login.email.errorRequired} data-msg-format={s.login.email.errorFormat}>
        <label for="li-email">{s.login.email.label}</label>
        <div class="field__control">
          <input id="li-email" name="email" type="email" autocomplete="email" dir="ltr" required aria-describedby="li-email-error" />
          <span class="field__check" aria-hidden="true">
            <Icon name="ph:check" width="16" height="16" aria-hidden="true" />
          </span>
        </div>
        <p class="field__error" id="li-email-error" hidden>
          <Icon name="ph:warning-circle" width="16" height="16" aria-hidden="true" />
          <span class="field__error-text"></span>
        </p>
      </div>

      <div class="field" data-msg-required={s.login.password.error}>
        <label for="li-password">{s.login.password.label}</label>
        <div class="field__control">
          <input id="li-password" name="password" type="password" autocomplete="current-password" dir="ltr" required aria-describedby="li-password-error" />
          <button
            type="button"
            class="field__reveal"
            data-reveal
            aria-controls="li-password"
            aria-pressed="false"
            aria-label={s.a11y.showPassword}
            data-label-show={s.a11y.showPassword}
            data-label-hide={s.a11y.hidePassword}
          >
            <Icon class="field__reveal-on" name="ph:eye" width="18" height="18" aria-hidden="true" />
            <Icon class="field__reveal-off" name="ph:eye-slash" width="18" height="18" aria-hidden="true" />
          </button>
          <span class="field__check" aria-hidden="true">
            <Icon name="ph:check" width="16" height="16" aria-hidden="true" />
          </span>
        </div>
        <p class="field__error" id="li-password-error" hidden>
          <Icon name="ph:warning-circle" width="16" height="16" aria-hidden="true" />
          <span class="field__error-text"></span>
        </p>
      </div>

      <button class="button button--primary form-submit" type="submit" data-submitting={s.login.submitting}>
        <span class="spinner" aria-hidden="true"></span>
        <span class="form-submit__label">{s.login.submit}</span>
      </button>

      {/* Linked on the team's instruction, with the endpoints now scheduled.
          It sits after the submit button, not beside the password label: it is
          the exit for a failed sign in, and putting it next to the field
          invites people who could have remembered to give up and take the long
          way round. The page it reaches is complete and integration-ready: the
          moment /api/auth/forgot-password answers, the flow works end to end
          with no change here. See BACKEND.md §1.1. */}
      <p class="auth__forgot">
        <a href={`${base}/forgot-password/`}>{s.login.forgot}</a>
      </p>
    </form>

    <p class="auth__alt">
      {s.login.noAccount}
      <a href={`${base}/signup/`}>{s.login.signupLink}</a>
    </p>
  </div>

  <!-- Hud waves, positioned away from the form itself. -->
  <div class="auth__aside">
    <Hud pose="waving" size="md" loop />
  </div>
</div>

<script>
  import { explainServerErrors, initForm } from '../../scripts/form';
  document
    .querySelectorAll<HTMLFormElement>('form.form-card')
    .forEach((form) => {
      initForm(form);

      /* "That email and password do not match" — never which of the two was
         wrong. Saying "no account with that email" would turn this form into a
         way to test whether an address is registered, one guess at a time.
         Recovery is offered because a wrong password is the likely cause and it
         is the only thing the person can act on. */
      explainServerErrors(
        form,
        { invalid_credentials: form.dataset.msgInvalid },
        [{ href: form.dataset.forgotUrl ?? '', text: form.dataset.forgotText ?? '' }],
      );
    });
</script>

<style>
  /* Mascot at the inline start, form beside it, the pair centred on the page.
     `order` rather than moving the markup: the form stays first in the DOM so
     keyboard and screen-reader users reach it immediately, while Hud — who is
     decoration and aria-hidden — simply renders ahead of it. Being logical,
     `order` also mirrors on its own, so he sits left in English and right in
     Arabic without a second rule. */
  .auth {
    display: flex;
    gap: var(--space-12);
    align-items: center;
    justify-content: center;
    padding-block: var(--space-16);
  }

  .auth__aside {
    order: -1;
  }

  .auth__main {
    flex: 0 1 30rem;
  }

  .auth__main h1 {
    margin-block: var(--space-3) var(--space-8);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }

  /* Centred under the submit button so it reads as the alternative to it,
     and quiet: this is the path for the minority who need it, not a second
     call to action competing with logging in. */
  .auth__forgot {
    margin: 0;
    text-align: center;
    font-size: var(--text-sm);
  }

  .auth__forgot a {
    color: var(--color-text-muted);
  }

  .auth__forgot a:hover {
    color: var(--color-text);
  }

  .auth__alt {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
  }

  .auth__aside {
    flex: 0 0 auto;
  }

  @media (max-width: 51.99rem) {
    .auth {
      flex-direction: column;
      padding-block: var(--space-10);
      gap: var(--space-8);
    }

    .auth__main {
      flex-basis: auto;
      inline-size: 100%;
    }

    .auth__aside {
      order: 0;
      align-self: center;
    }
  }
</style>
