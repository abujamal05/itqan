---
import Hud from '../Hud.astro';
import GirihField from '../GirihField.astro';
import { t, type Locale } from '../../i18n';
import { formEndpoints, appUrl } from '../../config';
import '../../styles/forms.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;
---

<section class="panel panel--navy auth-panel">
  <div class="panel__pattern on-navy" aria-hidden="true">
    <GirihField held={(row, col) => col + row < 8} radius={104} animate={false} />
  </div>

  <div class="container panel__inner auth">
    <div class="auth__intro on-navy">
      <h1>{s.login.heading}</h1>
      <div class="auth__hud">
        <Hud pose="waving" size="md" loop />
      </div>
    </div>

    <div class="auth__card">

    <form
      class="form-card"
      method="post"
      action={formEndpoints.login}
      novalidate
      data-server-error={s.login.serverError}
      data-success-url={appUrl}
    >
      <div class="form-summary" role="alert" tabindex="-1" hidden>
        <Hud pose="error" size="sm" />
        <div>
          <p class="form-summary__heading">{s.login.summaryHeading}</p>
          <ul class="form-summary__list"></ul>
        </div>
      </div>

      <div class="field" data-msg-required={s.login.email.errorRequired} data-msg-format={s.login.email.errorFormat}>
        <label for="li-email">{s.login.email.label}</label>
        <div class="field__control">
          <input id="li-email" name="email" type="email" autocomplete="email" dir="ltr" required aria-describedby="li-email-error" />
          <span class="field__check" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"></path></svg>
          </span>
        </div>
        <p class="field__error" id="li-email-error" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.5" r="0.5" fill="currentColor"></circle></svg>
          <span class="field__error-text"></span>
        </p>
      </div>

      <div class="field" data-msg-required={s.login.password.error}>
        <label for="li-password">{s.login.password.label}</label>
        <div class="field__control">
          <input id="li-password" name="password" type="password" autocomplete="current-password" dir="ltr" required aria-describedby="li-password-error" />
          <button
            type="button"
            class="field__reveal"
            data-reveal
            aria-controls="li-password"
            aria-pressed="false"
            aria-label={s.a11y.showPassword}
            data-label-show={s.a11y.showPassword}
            data-label-hide={s.a11y.hidePassword}
          >
            <svg class="field__reveal-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            <svg class="field__reveal-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18"></path><path d="M10.6 10.6a3 3 0 0 0 4.2 4.2"></path><path d="M9.9 5.2A9.6 9.6 0 0 1 12 5c6.4 0 10 7 10 7a17.9 17.9 0 0 1-3.2 4.2M6.2 6.2A17.7 17.7 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 4.1-.9"></path></svg>
          </button>
          <span class="field__check" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"></path></svg>
          </span>
        </div>
        <p class="field__error" id="li-password-error" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.5" r="0.5" fill="currentColor"></circle></svg>
          <span class="field__error-text"></span>
        </p>
      </div>

      <button class="button button--primary form-submit" type="submit" data-submitting={s.login.submitting}>
        <span class="spinner" aria-hidden="true"></span>
        <span class="form-submit__label">{s.login.submit}</span>
      </button>

      {/* Linked on the team's instruction, with the endpoints now scheduled.
          It sits after the submit button, not beside the password label: it is
          the exit for a failed sign in, and putting it next to the field
          invites people who could have remembered to give up and take the long
          way round. The page it reaches is complete and integration-ready: the
          moment /api/auth/forgot-password answers, the flow works end to end
          with no change here. See BACKEND.md §1.1. */}
      <p class="auth__forgot">
        <a href={`${base}/forgot-password/`}>{s.login.forgot}</a>
      </p>
    </form>

    <p class="auth__alt">
      {s.login.noAccount}
      <a href={`${base}/signup/`}>{s.login.signupLink}</a>
    </p>
  </div>

  </div>
</section>

<script>
  import { initForm } from '../../scripts/form';
  document
    .querySelectorAll<HTMLFormElement>('form.form-card')
    .forEach((form) => initForm(form));
</script>

<style>
  /* The form sits on a paper card floating over the navy girih ground. The card
     deliberately does NOT carry .on-navy, so it keeps the page's own surface
     tokens and the fields inside it stay at full contrast in both themes. */
  .auth-panel {
    padding-block: 0;
    overflow: hidden;
  }

  .auth {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
    gap: var(--space-16);
    align-items: center;
    padding-block: var(--space-20);
  }

  .auth__intro h1 {
    font-size: var(--text-6xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    text-wrap: balance;
    max-inline-size: 14ch;
  }

  [dir='ltr'] .auth__intro h1 {
    letter-spacing: var(--tracking-tight-latin);
  }

  .auth__sub {
    margin-block-start: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-inline-size: 34ch;
  }

  .auth__hud {
    margin-block-start: var(--space-10);
  }

  .auth__card {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl), var(--rim-light);
  }

  /* Centred under the submit button so it reads as the alternative to it, and
     quiet: this is the path for the minority who need it, not a second call to
     action competing with the one the page exists for. */
  .auth__forgot {
    margin: 0;
    text-align: center;
    font-size: var(--text-sm);
  }

  .auth__forgot a {
    color: var(--color-text-muted);
  }

  .auth__forgot a:hover {
    color: var(--color-text);
  }

  .auth__alt {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 63.99rem) {
    .auth {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
      padding-block: var(--space-12);
    }

    .auth__intro h1 {
      font-size: var(--text-4xl);
      max-inline-size: 20ch;
    }

    .auth__hud {
      margin-block-start: var(--space-6);
    }
  }

  @media (max-width: 39.99rem) {
    .auth__card {
      padding: var(--space-5);
      border-radius: var(--radius-lg);
    }
  }
</style>
