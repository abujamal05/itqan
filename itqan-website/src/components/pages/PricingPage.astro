---
/**
 * Pricing.
 *
 * THE PAGE'S JOB IS A FREE ACCOUNT, NOT A SALE. The site has one success
 * condition and it is a stranger signing up. A pricing page that pushes a
 * logged-out visitor toward a card inverts that, and for the anchor user —
 * unemployed, demoralised, arriving with no money — a price above the fold is a
 * reason to close the tab. So the free column is the long one, the price sits
 * below it, and the only button on the page creates a free account. There is no
 * checkout here at all: upgrading happens inside the app, where the account it
 * attaches to exists.
 *
 * WHAT IS DELIBERATELY MISSING, and each absence is a decision:
 *
 *   A third tier.      Standard advice is good/better/best with a middle option
 *                      engineered to win. There are two things to sell. A
 *                      manufactured third is the kind of thing the sceptical
 *                      user notices, and he leaves permanently on one of those.
 *   Scarcity.          No countdown, no "limited", no seats remaining. All of
 *                      it would be a lie, and a visible one.
 *   Social proof.      No counts, no logos, no testimonials, no accuracy
 *                      figure. None has been measured, so none can be claimed.
 *   An anchor price.   No "was", no struck-through number, no comparison to a
 *                      cost we have not verified.
 *
 * What is left is the actual argument: most of it is free, here is exactly what
 * costs money, here is exactly what it costs, cancel whenever.
 *
 * The `Offer` JSON-LD is not decoration. Buyers increasingly ask an assistant
 * what a product costs before they visit, and a price it cannot parse is a
 * question answered wrongly. The figure is in the markup as text as well.
 */
import { Icon } from 'astro-icon/components';
import { t, type Locale } from '../../i18n';
import { siteUrl } from '../../config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

/* Priced in USD because that is what is charged. Paddle does not bill in
   rials; publishing OMR here as the machine-readable price would put a figure
   in structured data that never appears on anyone's statement. */
const offer = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${s.site.name} ${s.pricing.paid.name}`,
  description: s.pricing.metaDescription,
  brand: { '@type': 'Brand', name: s.site.name },
  offers: {
    '@type': 'Offer',
    price: '7.78',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: `${siteUrl}${base}/pricing/`,
  },
};
---

<div class="container">
  <header class="page-head" data-enter>
    <p class="eyebrow">{s.pricing.eyebrow}</p>
    <h1>{s.pricing.heading}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
    <p class="page-head__intro">{s.pricing.intro}</p>
  </header>

  <section class="tiers reveal" aria-label={s.pricing.eyebrow}>
    <!-- Free first, and wider. The order is the argument. -->
    <article class="tier tier--free">
      <h2 class="tier__name">{s.pricing.free.name}</h2>
      <p class="tier__price">{s.pricing.free.price}</p>
      <p class="tier__for">{s.pricing.free.for}</p>
      <ul class="tier__list">
        {
          s.pricing.free.items.map((item) => (
            <li>
              <Icon class="tier__mark" name="ph:check" width="16" height="16" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="tier tier--paid">
      <h2 class="tier__name">{s.pricing.paid.name}</h2>
      <p class="tier__price">
        <span class="num">{s.pricing.paid.price}</span>
        <span class="tier__omr num">{s.pricing.paid.priceOmr}</span>
      </p>
      <p class="tier__for">{s.pricing.paid.for}</p>
      <ul class="tier__list">
        {
          s.pricing.paid.items.map((item) => (
            <li>
              <Icon class="tier__mark" name="ph:plus" width="16" height="16" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="tier__note">{s.pricing.ctaNote}</p>
    </article>
  </section>

  <section class="pricing-terms reveal">
    <h2>{s.pricing.guaranteeHeading}</h2>
    <p>{s.pricing.guarantee}</p>
  </section>

  <section class="pricing-faq reveal">
    <h2>{s.pricing.faqHeading}</h2>
    <dl>
      {
        s.pricing.faq.map((item) => (
          <div class="pricing-faq__item">
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <div class="page-cta reveal">
    <a class="button button--primary button--arrow" href={`${base}/signup/`}>
      <span>{s.actions.signup}</span>
      <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
    </a>
  </div>
</div>

<script type="application/ld+json" set:html={JSON.stringify(offer)} is:inline />

<style>
  h2 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  /* Free is the wider column. Two tiers side by side at equal weight would say
     they are equally the point, and they are not. */
  .tiers {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-16);
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  /* The free tier carries the emphasis, not the paid one. An upsell should not
     be the brightest object on a page aimed at people without money. */
  .tier--free {
    border-color: var(--color-border-accent);
    background: var(--color-surface-warm);
  }

  .tier__name {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .tier__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-4xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  /* Beside the charged figure, never instead of it: the statement says dollars,
     so the page has to as well. */
  .tier__omr {
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }

  .tier__for { color: var(--color-text-muted); }

  .tier__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .tier__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .tier__mark {
    flex: 0 0 auto;
    margin-block-start: 0.25em;
    color: var(--color-accent-ink);
  }

  .tier__note {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pricing-terms,
  .pricing-faq { padding-block: var(--space-16); }

  .pricing-terms p {
    max-inline-size: 60ch;
    margin-block-start: var(--space-4);
  }

  .pricing-faq dl {
    margin-block-start: var(--space-8);
    display: grid;
    gap: var(--space-8);
  }

  .pricing-faq dt {
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-2);
  }

  .pricing-faq dd {
    margin: 0;
    max-inline-size: 62ch;
    color: var(--color-text-muted);
  }

  @media (max-width: 52rem) {
    .tiers {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-block: var(--space-12);
    }
    .pricing-terms,
    .pricing-faq { padding-block: var(--space-12); }
  }
</style>
