---
/**
 * Proof.
 *
 * The page a sceptic reads before creating an account, so it shows the whole
 * evidence chain rather than a summary of it. Hud is absent from this file
 * entirely and that is a hard rule: every block here is a judgement about a
 * person, and the mascot never stands beside one.
 *
 * The worked example is a real table, not a card grid. A reader comparing five
 * rows on three columns needs a table, and dressing one up as cards would cost
 * them the comparison the page exists to offer.
 */
import Badge from '../Badge.astro';
import GirihField from '../GirihField.astro';
import GirihTile from '../GirihTile.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

/* A row whose skill is unmet is an open piece; everything else is held. The
   copy carries the same distinction in words, so the tile is reinforcement and
   never the only carrier. */
const isHeld = (confidence: string, skill: string) =>
  confidence === 'strong' && skill !== s.proof.example.rows[3].skill;
---

<section class="panel panel--navy on-navy proof-head">
  <div class="panel__pattern reveal">
    <GirihField held={(row, col) => col + row < 8} radius={110} />
  </div>

  <div class="container panel__inner">
    <div class="page-head">
      <h1 class="title reveal">{s.proof.heading}</h1>
      <p class="page-head__intro reveal">{s.proof.intro}</p>
    </div>
  </div>
</section>

<!-- The worked example. -->
<section class="panel panel--paper">
  <div class="container panel__inner">
    <h2 class="heading reveal">{s.proof.example.heading}</h2>
    <p class="lede reveal">{s.proof.example.intro}</p>

    <div class="table-scroll reveal">
      <table class="proof-table">
        <thead>
          <tr>
            <th scope="col">{s.proof.example.courseLabel}</th>
            <th scope="col">{s.proof.example.skillLabel}</th>
            <th scope="col">{s.proof.example.whyLabel}</th>
          </tr>
        </thead>
        <tbody>
          {
            s.proof.example.rows.map((row) => {
              const held = isHeld(row.confidence, row.skill);
              return (
                <tr>
                  {/* The flex and grid boxes are INSIDE the cells, never on them:
                      a th or td given display:flex stops being a table cell and
                      drops out of the table's column layout entirely. */}
                  <th scope="row">
                    <span class="proof-table__piece">
                      <GirihTile
                        name={held ? 'pentagon' : 'rhombus'}
                        state={held ? 'set' : 'open'}
                        size={24}
                      />
                      <span>{row.course}</span>
                    </span>
                  </th>
                  <td>
                    <span class="proof-table__stand">
                      <span class="proof-table__verdict">{row.skill}</span>
                      {/* The badge marks CONFIDENCE IN THE READING, not match
                          strength, so it is shown only where the reading is
                          uncertain. Rendering "Strong match" beside a "Not yet"
                          verdict said two contradictory things about the same
                          row, and on the one page a sceptic reads closely. An
                          unlabelled row is a plain statement; a labelled one is
                          asking to be confirmed. */}
                      {row.confidence !== 'strong' && <Badge kind="suggested" locale={locale} />}
                    </span>
                  </td>
                  <td class="proof-table__why">{row.why}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <p class="proof-note">{s.proof.example.note}</p>
  </div>
</section>

<!-- How a recommendation is justified. -->
<section class="panel panel--sunken">
  <div class="container panel__inner">
    <h2 class="heading reveal">{s.proof.how.heading}</h2>
    <div class="proof-prose reveal">
      <p>{s.proof.how.p1}</p>
      <p>{s.proof.how.p2}</p>
    </div>
  </div>
</section>

<!-- The limits. The page's most important block, so it gets the navy register
     rather than a grey footnote at the bottom. -->
<section class="panel panel--navy on-navy">
  <div class="panel__pattern" aria-hidden="true">
    <GirihField held={(row, col) => col - row < 1} animate={false} />
  </div>

  <div class="container panel__inner">
    <h2 class="heading reveal">{s.proof.limits.heading}</h2>
    <ul class="limits reveal">
      {
        s.proof.limits.items.map((item) => (
          <li class="limits__item">
            <GirihTile name="rhombus" state="open" size={22} />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <div class="actions">
      <a class="button button--primary button--arrow" href={`${base}/signup/`}>
        <span>{s.actions.signup}</span>
        <svg class="button__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .proof-head {
    padding-block: 0;
  }

  /* A table this wide cannot reflow into something readable on a phone, so it
     scrolls inside its own box and the page never scrolls sideways. */
  .table-scroll {
    margin-block-start: var(--space-10);
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm), var(--rim-light);
  }

  .proof-table {
    inline-size: 100%;
    border-collapse: collapse;
    min-inline-size: 46rem;
    text-align: start;
  }

  .proof-table th,
  .proof-table td {
    text-align: start;
    vertical-align: top;
    padding: var(--space-5);
    border-block-end: 1px solid var(--color-border);
  }

  .proof-table thead th {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    background-color: var(--color-surface-sunken);
    white-space: nowrap;
  }

  .proof-table tbody tr:last-child th,
  .proof-table tbody tr:last-child td {
    border-block-end: none;
  }

  .proof-table__piece {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .proof-table__stand {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  /* Column widths, so the three do not fight over the same space. The why
     column carries the reasoning and gets the room; the other two are short and
     fixed. */
  .proof-table th:first-child {
    inline-size: 22%;
  }

  .proof-table th:nth-child(2) {
    inline-size: 20%;
  }

  .proof-table__verdict {
    font-weight: var(--weight-semibold);
  }

  .proof-table__why {
    color: var(--color-text-muted);
    min-inline-size: 22rem;
    line-height: 1.6;
  }

  .proof-note {
    margin-block-start: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-inline-size: var(--measure);
  }

  .proof-prose {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-8);
    color: var(--color-text-muted);
    max-inline-size: var(--measure);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .limits {
    list-style: none;
    margin: var(--space-10) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    max-inline-size: 56rem;
  }

  .limits__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--color-border);
    line-height: 1.6;
  }

  .limits__item:last-child {
    border-block-end: none;
    padding-block-end: 0;
  }

  @media (max-width: 51.99rem) {
    .proof-prose {
      font-size: var(--text-base);
    }
  }
</style>
