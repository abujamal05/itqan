---
import { Icon } from 'astro-icon/components';
/* The proof page earns the sign up before the sign up.
   Brand rule: no mascot anywhere on this page. It is an evidence surface. */
import Badge from '../Badge.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;
---

<div class="container">
  <header class="page-head reveal">
    <p class="eyebrow">{s.proof.eyebrow}</p>
    <h1>{s.proof.heading}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
    <p class="page-head__intro">{s.proof.intro}</p>
  </header>

  <section class="proof-example">
    <div class="section__head reveal">
      <h2>{s.proof.example.heading}</h2>
    </div>
    <p class="proof-example__intro reveal">{s.proof.example.intro}</p>

    <div class="proof-rows">
      {
        s.proof.example.rows.map((row) => (
          <article class="proof-row reveal">
            <div class="proof-row__head">
              <div class="proof-row__pair">
                <div class="proof-row__side">
                  <span class="proof-row__label">{s.proof.example.courseLabel}</span>
                  <span class="proof-row__value"><bdi>{row.course}</bdi></span>
                </div>

                <div class="proof-row__connector" aria-hidden="true">
                  <svg viewBox="0 0 80 24" width="80" height="24" fill="none" preserveAspectRatio="none">
                    <line class="draw-stroke" x1="5" y1="12" x2="60" y2="12" pathLength="1" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></line>
                    <path class="draw-stroke" d="M53 6l9 6-9 6" pathLength="1" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <circle cx="5" cy="12" r="3.5" fill="currentColor"></circle>
                  </svg>
                </div>

                <div class="proof-row__side">
                  <span class="proof-row__label">{s.proof.example.skillLabel}</span>
                  <span class="proof-row__value proof-row__value--skill"><bdi>{row.skill}</bdi></span>
                </div>
              </div>
              {/* The badge marks CONFIDENCE IN THE READING, not match strength, so
                  it appears only where the reading is uncertain. Rendering
                  "Strong match" beside the "Not yet" verdict on the Power BI row
                  said two contradictory things about one row, on the page a
                  sceptic reads closest. An unlabelled row is a plain statement;
                  a labelled one is asking to be confirmed. */}
              {row.confidence !== 'strong' && <Badge kind="suggested" locale={locale} />}
            </div>
            <div class="proof-row__why">
              <span class="proof-row__label">{s.proof.example.whyLabel}</span>
              <p>{row.why}</p>
            </div>
          </article>
        ))
      }
    </div>
    <p class="proof-note">{s.proof.example.note}</p>
  </section>

  <section class="proof-how reveal">
    <h2>{s.proof.how.heading}</h2>
    <p>{s.proof.how.p1}</p>
    <p>{s.proof.how.p2}</p>
  </section>

  <section class="proof-limits reveal">
    <h2>{s.proof.limits.heading}</h2>
    <ul>
      {
        s.proof.limits.items.map((item) => (
          <li>
            <span class="proof-limits__mark" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path></svg>
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="page-cta reveal">
    <a class="button button--primary button--arrow" href={`${base}/signup/`}>
      <span>{s.actions.signup}</span>
      <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
    </a>
  </div>
</div>

<style>
  /* .page-head and its rule/intro now live in global.css — this block was
     duplicated verbatim across four page components. */

  h2 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    margin-block-end: var(--space-4);
  }

  .proof-example__intro {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin-block-end: var(--space-8);
  }

  .proof-rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-inline-size: 52rem;
  }

  .proof-row {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  /* Both classes, so this outweighs `html.reveal-ready .reveal` in global.css —
     otherwise the reveal's transition list wins and the hover shadow snaps. */
  .proof-row.reveal {
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .proof-row:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--color-border-strong);
    }
  }

  .proof-row__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .proof-row__pair {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: nowrap;
    min-inline-size: 0;
  }

  .proof-row__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .proof-row__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .proof-row__value {
    font-weight: var(--weight-semibold);
  }

  .proof-row__value--skill {
    background-color: var(--color-accent-tint);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    align-self: flex-start;
  }

  /* Same drawn connector motif as the home translation card. */
  .proof-row__connector {
    color: var(--color-accent);
    inline-size: 64px;
    flex: 0 0 auto;
  }

  .proof-row__connector svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  :global([dir='rtl']) .proof-row__connector svg {
    transform: scaleX(-1);
  }

  .proof-row__why {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
  }

  .proof-row__why p {
    margin-block-start: var(--space-1);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .proof-note {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .proof-how {
    padding-block: var(--space-16) 0;
    max-inline-size: 44rem;
  }

  .proof-how p {
    line-height: 1.6;
  }

  .proof-how p + p {
    margin-block-start: var(--space-4);
  }

  .proof-limits {
    margin-block-start: var(--space-16);
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-lg);
    padding: var(--space-10);
    max-inline-size: 46rem;
  }

  .proof-limits ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .proof-limits li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    line-height: 1.6;
  }

  .proof-limits__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    margin-block-start: 2px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent-tint);
    color: var(--color-text);
    flex: 0 0 auto;
  }

  /* Mobile: stack the match as a clear vertical group — verdict on top, then
     course, a downward connector, and the skill. Proximity keeps them read as
     one unit; the connector rotates to point down the reading flow. */
  @media (max-width: 39.99rem) {
    .proof-row__head {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .proof-row__pair {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      inline-size: 100%;
    }

    /* Square cell so the rotated arrow fits its own layout box; at 40x12 it
       overhung by 14px top and bottom and touched the rows either side. */
    .proof-row__connector {
      inline-size: 40px;
      block-size: 40px;
      align-self: flex-start;
      margin-inline-start: var(--space-4);
      display: grid;
      place-items: center;
    }

    .proof-row__connector svg {
      inline-size: 40px;
      transform: rotate(90deg);
    }

    /* Points DOWN in Arabic too. The extra scaleX(-1) applied before the
       rotation and turned the arrow back up the page. */
    :global([dir='rtl']) .proof-row__connector svg {
      transform: rotate(90deg);
    }
  }

  .page-cta {
    padding-block: var(--space-16);
    display: flex;
    justify-content: center;
  }
</style>
