---
/**
 * Proof.
 *
 * FOUR sections, each making exactly one argument:
 *   1. what this page is
 *   2. the run pauses and waits for you          (the confirmation screen)
 *   3. every match carries its reason and source (the job matches screen)
 *   4. what it still cannot do
 *
 * WHAT WAS REMOVED AND WHY. The page used to lead with a fabricated Junior Data
 * Analyst table labelled "An illustrative example". A page called Proof whose
 * centrepiece is a mockup proves nothing, and for the sceptical user this page
 * exists for it is worse than proving nothing: it invites him to notice that the
 * evidence is invented. The prose section explaining the evidence chain went with
 * it, because the screen beside it now makes that argument by showing instead of
 * asserting, and a section is allowed one idea.
 *
 * The screens come from Onboarding/scripts/capture-app-shots.mjs, captured
 * against the running product with a seeded account, so they cannot drift into
 * fiction. Re-run it after any app redesign.
 *
 * Brand rule: no mascot anywhere on this page. It is an evidence surface.
 */
import { Icon } from 'astro-icon/components';
import Shot from '../Shot.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;
---

<div class="container">
  <header class="page-head" data-enter>
    <p class="eyebrow">{s.proof.eyebrow}</p>
    <h1>{s.proof.heading}</h1>
    <div class="page-head__rule" aria-hidden="true"></div>
    <p class="page-head__intro">{s.proof.intro}</p>
  </header>

  <!-- 2. The pause. The trust mechanism, shown running. -->
  <section class="evidence reveal">
    <div class="evidence__copy">
      <h2>{s.proof.confirm.heading}</h2>
      <p>{s.proof.confirm.body}</p>
    </div>
    <figure class="evidence__figure">
      <Shot name="confirm" alt={s.proof.confirm.body} />
      <figcaption>{s.proof.confirm.caption}</figcaption>
    </figure>
  </section>

  <!-- 3. The evidence chain, shown rather than described. -->
  <section class="evidence evidence--flip reveal">
    <div class="evidence__copy">
      <h2>{s.proof.match.heading}</h2>
      <p>{s.proof.match.body}</p>
    </div>
    <figure class="evidence__figure">
      <Shot name="jobs" alt={s.proof.match.body} />
      <figcaption>{s.proof.match.caption}</figcaption>
    </figure>
  </section>

  <!-- 4. The limits. Kept whole: it is the most load bearing block on the page. -->
  <section class="proof-limits reveal">
    <h2>{s.proof.limits.heading}</h2>
    <ul>
      {
        s.proof.limits.items.map((item) => (
          <li>
            <Icon class="proof-limits__mark" name="ph:minus" width="16" height="16" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="page-cta reveal">
    <a class="button button--primary button--arrow" href={`${base}/signup/`}>
      <span>{s.actions.signup}</span>
      <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
    </a>
  </div>
</div>

<style>
  h2 {
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  /* One claim, one screen proving it, side by side. The pair alternates down the
     page so the eye is not tracking a single column of identical blocks, and the
     gap is generous because these are two separate arguments rather than two
     paragraphs of the same one. */
  .evidence {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-16);
    align-items: center;
    padding-block: var(--space-24);
    border-block-start: 1px solid var(--color-border);
  }

  .evidence--flip .evidence__copy {
    order: 2;
  }

  .evidence__copy p {
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: var(--text-lg);
    max-inline-size: 46ch;
  }

  .evidence__figure {
    margin: 0;
  }

  .evidence__figure figcaption {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* ---- The limits ---- */
  .proof-limits {
    margin-block-start: var(--space-24);
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-lg);
    padding: var(--space-12);
    max-inline-size: 52rem;
  }

  .proof-limits ul {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }

  .proof-limits li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .proof-limits :global(.proof-limits__mark) {
    margin-block-start: 6px;
    color: var(--color-accent-ink);
  }


  /* ---- Adaptation ----
     Below the two column width the pair stacks with the SCREEN first: on a phone
     the image is what tells you which claim you are about to read, and putting a
     wall of prose above it makes the reader scroll to find out. `order` covers
     both variants at once, so the flipped section needs no rule of its own. */
  @media (max-width: 63.99rem) {
    .evidence,
    .evidence--flip {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      padding-block: var(--space-16);
    }

    .evidence__copy,
    .evidence--flip .evidence__copy {
      order: 2;
    }

    .evidence__figure {
      order: 1;
    }

    .proof-limits {
      margin-block-start: var(--space-16);
      padding: var(--space-8);
    }

  }
</style>
