---
import { Icon } from 'astro-icon/components';
import Hud from '../Hud.astro';
import { t, type Locale } from '../../i18n';
import { formEndpoints, privacyPolicyVersion } from '../../config';
import '../../styles/forms.css';

/* Signing up now lands on VERIFICATION, not on the app.
 *
 * A new account is signed in but unproved, and the API refuses uploads,
 * analysis and profile writes until a code is accepted — so sending someone to
 * /app/ would drop them into a flow that cannot progress, with nothing on
 * screen explaining why. `appUrl` (/api/handoff) would now redirect here
 * anyway; going straight there saves a round trip for what is, at signup, the
 * only possible outcome. Log in still uses `appUrl`, because a returning user
 * may well be verified already and handoff is what knows. */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;
---

<div class="container auth">
  <div class="auth__main">
    <p class="eyebrow">{s.signup.eyebrow}</p>
    <h1>{s.signup.heading}</h1>
    <p class="auth__sub">{s.signup.sub}</p>

    <form
      class="form-card"
      method="post"
      action={formEndpoints.signup}
      novalidate
      data-server-error={s.signup.serverError}
      {/* The shared refusals, rendered here because this script cannot read the
      locale: a string baked into the bundle would be English on an Arabic
      page. See `serverErrorMessage` — the page's own `data-server-error`
      stays the last resort. */}
      data-err-network={s.err.network}
      data-err-server={s.err.server}
      data-err-session={s.err.session}
      data-err-credentials={s.err.credentials}
      data-err-email-taken={s.err.emailTaken}
      data-err-unverified={s.err.unverified}
      data-err-consent-required={s.err.consentRequired}
      data-err-invalid-code={s.err.invalidCode}
      data-err-code-expired={s.err.codeExpired}
      data-err-invalid-input={s.err.invalidInput}
      data-err-not-found={s.err.notFound}
      data-err-rate-limited={s.err.rateLimited}
      data-err-rate-limited-in={s.err.rateLimitedIn}
      data-msg-taken={s.signup.emailTaken}
      data-login-url={`${base}/login/`}
      data-login-text={s.signup.loginLink}
      data-forgot-url={`${base}/forgot-password/`}
      data-forgot-text={s.login.forgot}
      data-success-url={`${base}/verify-email/`}
    >
      <div class="form-summary" role="alert" tabindex="-1" hidden>
        <Icon class="form-summary__icon" name="ph:warning-duotone" width="22" height="22" aria-hidden="true" />
        <div>
          <p class="form-summary__heading">{s.signup.summaryHeading}</p>
          <ul class="form-summary__list"></ul>
        </div>
      </div>

      <div class="field" data-msg-required={s.signup.name.error}>
        <label for="su-name">{s.signup.name.label}</label>
        <div class="field__control">
          <input id="su-name" name="name" type="text" autocomplete="name" dir="auto" required aria-describedby="su-name-error" />
          <span class="field__check" aria-hidden="true">
            <Icon name="ph:check" width="16" height="16" aria-hidden="true" />
          </span>
        </div>
        <p class="field__error" id="su-name-error" hidden>
          <Icon name="ph:warning-circle" width="16" height="16" aria-hidden="true" />
          <span class="field__error-text"></span>
        </p>
      </div>

      <div class="field" data-msg-required={s.signup.email.errorRequired} data-msg-format={s.signup.email.errorFormat}>
        <label for="su-email">{s.signup.email.label}</label>
        <div class="field__control">
          <input id="su-email" name="email" type="email" autocomplete="email" dir="ltr" required aria-describedby="su-email-error" />
          <span class="field__check" aria-hidden="true">
            <Icon name="ph:check" width="16" height="16" aria-hidden="true" />
          </span>
        </div>
        <p class="field__error" id="su-email-error" hidden>
          <Icon name="ph:warning-circle" width="16" height="16" aria-hidden="true" />
          <span class="field__error-text"></span>
        </p>
      </div>

      <div class="field" data-msg-required={s.signup.password.error} data-msg-minlength={s.signup.password.error} data-msg-weak={s.signup.password.errorWeak} data-check="password">
        <label for="su-password">{s.signup.password.label}</label>
        <span class="field__hint" id="su-password-hint">{s.signup.password.hint}</span>
        <div class="field__control">
          <input id="su-password" name="password" type="password" autocomplete="new-password" dir="ltr" required minlength="8" aria-describedby="su-password-hint su-password-error" />
          <button
            type="button"
            class="field__reveal"
            data-reveal
            aria-controls="su-password"
            aria-pressed="false"
            aria-label={s.a11y.showPassword}
            data-label-show={s.a11y.showPassword}
            data-label-hide={s.a11y.hidePassword}
          >
            <Icon class="field__reveal-on" name="ph:eye" width="18" height="18" aria-hidden="true" />
            <Icon class="field__reveal-off" name="ph:eye-slash" width="18" height="18" aria-hidden="true" />
          </button>
          <span class="field__check" aria-hidden="true">
            <Icon name="ph:check" width="16" height="16" aria-hidden="true" />
          </span>
        </div>
        <p class="field__error" id="su-password-error" hidden>
          <Icon name="ph:warning-circle" width="16" height="16" aria-hidden="true" />
          <span class="field__error-text"></span>
        </p>
      </div>

      <!-- Consent: required, unticked by default. Explicit consent is the only
           lawful basis available here; a pre ticked box is not consent.

           The hidden version travels WITH the tick, because the two are only
           worth anything together: the checkbox records that this person
           agreed, the version records what they agreed to. It is not a user
           facing control and carries no label, so it stays outside the visible
           field and out of the tab order. See `privacyPolicyVersion`. -->
      <input type="hidden" name="policy_version" value={privacyPolicyVersion} />
      <div class="field field--checkbox" data-msg-required={s.signup.consent.error}>
        <div class="field__checkbox-row">
          <input id="su-consent" name="consent" type="checkbox" required aria-describedby="su-consent-error" />
          <label for="su-consent">
            {s.signup.consent.labelBefore}<a
              href={`${base}/privacy/`}>{s.signup.consent.privacyLink}</a>{s.signup.consent.labelBetween}<a
              href={`${base}/terms/`}>{s.signup.consent.termsLink}</a>{s.signup.consent.labelAfter}
          </label>
        </div>
        <p class="field__error" id="su-consent-error" hidden>
          <Icon name="ph:warning-circle" width="16" height="16" aria-hidden="true" />
          <span class="field__error-text"></span>
        </p>
      </div>

      <button class="button button--primary form-submit" type="submit" data-submitting={s.signup.submitting}>
        <span class="spinner" aria-hidden="true"></span>
        <span class="form-submit__label">{s.signup.submit}</span>
      </button>
    </form>

    <p class="auth__alt">
      {s.signup.haveAccount}
      <a href={`${base}/login/`}>{s.signup.loginLink}</a>
    </p>
  </div>

  <!-- Hud waves, positioned away from the form itself. -->
  <div class="auth__aside">
    <Hud pose="waving" size="md" loop />
  </div>
</div>

<script>
  import { explainServerErrors, initForm } from '../../scripts/form';
  document
    .querySelectorAll<HTMLFormElement>('form.form-card')
    .forEach((form) => {
      initForm(form);

      /* An address that already has an account is the most common way this form
         fails, and it used to be indistinguishable from a server outage: both
         said "try again in a moment", and only one of them could ever come true.

         Saying so DOES confirm the address is registered. That is admissible
         here and not elsewhere: `POST /api/auth/signup` already answers 409
         `email_taken` to anyone who posts this form, so the disclosure is on the
         wire either way and this only stops the person in front of us being the
         one kept in the dark. Forgot-password deliberately does NOT do this,
         because there the server genuinely refuses to say. If that 409 is ever
         removed, this message goes with it. */
      explainServerErrors(
        form,
        { email_taken: form.dataset.msgTaken },
        [
          { href: form.dataset.loginUrl ?? '', text: form.dataset.loginText ?? '' },
          { href: form.dataset.forgotUrl ?? '', text: form.dataset.forgotText ?? '' },
        ],
      );
    });
</script>

<style>
  /* Mascot at the inline start, form beside it, the pair centred on the page.
     `order` rather than moving the markup: the form stays first in the DOM so
     keyboard and screen-reader users reach it immediately, while Hud — who is
     decoration and aria-hidden — simply renders ahead of it. Being logical,
     `order` also mirrors on its own, so he sits left in English and right in
     Arabic without a second rule. */
  .auth {
    display: flex;
    gap: var(--space-12);
    align-items: center;
    justify-content: center;
    padding-block: var(--space-16);
  }

  .auth__aside {
    order: -1;
  }

  .auth__main {
    flex: 0 1 30rem;
  }

  .auth__main h1 {
    margin-block-start: var(--space-3);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }

  .auth__sub {
    margin-block: var(--space-3) var(--space-8);
    color: var(--color-text-muted);
  }

  .auth__alt {
    margin-block-start: var(--space-6);
    color: var(--color-text-muted);
  }

  .auth__aside {
    flex: 0 0 auto;
  }

  @media (max-width: 51.99rem) {
    .auth {
      flex-direction: column;
      padding-block: var(--space-10);
      gap: var(--space-8);
    }

    .auth__main {
      flex-basis: auto;
      inline-size: 100%;
    }

    .auth__aside {
      order: 0;
      align-self: center;
    }
  }
</style>
