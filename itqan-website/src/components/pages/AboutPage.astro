---
/**
 * Who we are. FIVE sections, down from eight.
 *
 * What was cut and why:
 *  - "What Itqan does" repeated the home page's four steps. Said once, on home.
 *  - Mission and vision were a section of their own holding two sentences; they
 *    now sit under the opening statement, which is where a reader looks for them.
 *  - "Where we sit" was a paragraph of institutional detail (UTAS, MTCIT, Khuta)
 *    that answers a question no job seeker is asking. Reduced to one line.
 *  - "How we do it" and "What we refuse" were two sections making one argument:
 *    here is the standard we hold, here is what that rules out. Now one section,
 *    two columns.
 *
 * The survey is the page's centre of gravity now, because it is the only real
 * evidence on it. It is rendered as three meters rather than a paragraph, and
 * every figure is a ratio in words: the sample only supports "roughly two
 * thirds", so printing "67%" would be inventing precision the data has not got.
 *
 * ONE Hud, in the opening section, and none below it.
 */
import { Icon } from 'astro-icon/components';
import Hud from '../Hud.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

/**
 * The team, from itqan-pitch/build/team.json.
 *
 * The files in public/team ARE 720x720 squares, all four of them, verified
 * rather than assumed: the comment that used to sit here warned about tall
 * originals and centre crops, which is not true of what is on disk and sent
 * the last person looking in the wrong direction. The cropping bug was in the
 * CSS, and it is documented at .about-team__photo.
 */
const team = [
  { slug: 'ahmad', name: 'Ahmad Faraj', nameAr: 'أحمد فرج', role: 'Business Developer', roleAr: 'مطوّر أعمال', url: 'https://www.linkedin.com/in/abujamal/' },
  { slug: 'samin', name: 'Samin Rezaei', nameAr: 'سامين رضائي', role: 'UI/UX Engineer', roleAr: 'مهندسة تجربة وواجهة المستخدم', url: 'https://www.linkedin.com/in/saminrezaei/' },
  { slug: 'amin', name: 'Amin Mohammed', nameAr: 'أمين محمد', role: 'AI Engineer', roleAr: 'مهندس ذكاء اصطناعي', url: 'https://linkedin.com/in/amin-patra/' },
  { slug: 'gheath', name: 'Gheath Wahab', nameAr: 'غياث وهاب', role: 'Software Engineer', roleAr: 'مهندس برمجيات', url: 'https://www.linkedin.com/in/gheath-wahab/' },
];

const holds = [
  { icon: 'ph:chart-bar-duotone', title: s.about.how1Title, body: s.about.how1Body },
  { icon: 'ph:seal-check-duotone', title: s.about.how2Title, body: s.about.how2Body },
  { icon: 'ph:shield-check-duotone', title: s.about.how3Title, body: s.about.how3Body },
];

const refusals = [s.about.refuse1, s.about.refuse2, s.about.refuse3, s.about.refuse4];
---

<!-- 1. The belief. One idea, and the only display-scale type on the page
     until the mission band below it. -->
<section class="about-why">
  <div class="container about-why__grid">
    <div class="about-why__copy">
      <p class="eyebrow" data-enter>{s.about.eyebrow}</p>
      <h1 class="about-why__heading" data-enter>{s.about.whyHeading}</h1>
      <div class="about-why__rule" aria-hidden="true" data-enter></div>
      <p class="about-why__body" data-enter>{s.about.whyBody}</p>
    </div>

    <div class="about-why__figure" data-enter>
      <Hud pose="idle" size="lg" loop eager />
    </div>
  </div>
</section>

<!-- 2. What we are for. Its own section now, and the page's one moment of
     scale: navy is the most emphatic surface the palette has, and two sentences
     that are meant to outlive every other line on the site have earned it. -->
<section class="mv">
  <div class="container mv__inner">
    <p class="mv__eyebrow reveal">{s.about.mvHeading}</p>

    <div class="mv__pair stagger">
      <figure class="mv__item reveal">
        <figcaption class="mv__label">{s.about.missionLabel}</figcaption>
        <blockquote class="mv__text">{s.about.mission}</blockquote>
      </figure>

      <span class="mv__rule reveal" aria-hidden="true"></span>

      <figure class="mv__item reveal">
        <figcaption class="mv__label">{s.about.visionLabel}</figcaption>
        <blockquote class="mv__text">{s.about.vision}</blockquote>
      </figure>
    </div>
  </div>
</section>

<!-- 3. The evidence. The page's centre of gravity, and the only real data on it.
        Meters rather than a paragraph, because a proportion is a shape. -->
<section class="section section--sunken">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.evidenceEyebrow}</p>
      <h2 class="section__heading">{s.about.stats.heading}</h2>
    </div>

    <ul class="stats stagger">
      {
        s.about.stats.items.map((item) => (
          <li class="stat reveal">
            {/* The accessible name carries the whole finding as a sentence, so a
                screen reader never has to reassemble it from a figure and a
                fragment sitting in different elements. */}
            <div
              class="stat__figure"
              role="img"
              aria-label={`${item.prefix} ${item.figure} ${item.label}`}
            >
              <span class="stat__prefix" aria-hidden="true">{item.prefix}</span>
              <span class="stat__value" aria-hidden="true">{item.figure}</span>
            </div>

            {/* The meter encodes the approximation; the number behind it is never
                printed, because the sample does not support that precision. */}
            <div class="meter" aria-hidden="true">
              <div class="meter__fill" style={`--fill: ${item.value}%`}></div>
            </div>

            <p class="stat__label" aria-hidden="true">{item.label}</p>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<!-- 4. The standard we hold, and what it rules out. One argument, two columns. -->
<section class="section">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.howEyebrow}</p>
      <h2 class="section__heading">{s.about.holdHeading}</h2>
    </div>

    <div class="hold">
      <ul class="hold__list stagger">
        {
          holds.map((item) => (
            <li class="hold__item reveal">
              <span class="hold__icon" aria-hidden="true">
                <Icon name={item.icon} width="24" height="24" />
              </span>
              <div>
                <h3 class="hold__title">{item.title}</h3>
                <p class="hold__body">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="refuse reveal">
        <h3 class="refuse__heading">{s.about.refuseHeading}</h3>
        <ul class="refuse__list">
          {
            refusals.map((line) => (
              <li>
                <Icon name="ph:x" width="16" height="16" aria-hidden="true" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
        </div>
    </div>
  </div>
</section>

<!-- 5. The team, and where we sit, together: both answer "who is behind this". -->
<section class="section section--sunken">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.teamEyebrow}</p>
      <h2 class="section__heading">{s.about.teamHeading}</h2>
    </div>

    <ul class="about-team stagger">
      {
        team.map((member) => {
          const name = locale === 'ar' ? member.nameAr : member.name;
          const role = locale === 'ar' ? member.roleAr : member.role;
          return (
            <li class="about-team__member reveal">
              <img
                class="about-team__photo"
                src={`/team/${member.slug}.jpg`}
                alt=""
                width="720"
                height="720"
                loading="lazy"
                decoding="async"
              />
              <p class="about-team__name"><bdi>{name}</bdi></p>
              <p class="about-team__role">{role}</p>
              <a
                class="about-team__link"
                href={member.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.about.linkedinLabel.replace('{name}', name)}
              >
                <Icon name="ph:linkedin-logo" width="18" height="18" aria-hidden="true" />
              </a>
            </li>
          );
        })
      }
    </ul>

  </div>
</section>

<!-- The standing action. A div rather than a <section>, matching /proof and
     /how-it-works: the call to action is chrome every page carries, not an idea
     this one is making, and counting it as a section would push About to six.
     The dashboard screenshot went with it — home already shows that screen, and
     repeating it here says nothing new. -->
<div class="container page-cta reveal">
  <h2 class="section__heading">{s.home.closing.heading}</h2>
  <p class="page-cta__body">{s.home.closing.body}</p>
  <a class="button button--primary button--arrow" href={`${base}/signup/`}>
    <span>{s.actions.signup}</span>
    <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
  </a>
</div>

<style>
  /* ---- 1. The opening ---- */
  .about-why {
    padding-block: var(--space-20) var(--space-16);
  }

  .about-why__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-12);
    align-items: center;
  }

  .about-why__heading {
    margin-block-start: var(--space-3);
    font-size: clamp(var(--text-4xl), 2.6vw + 1.25rem, var(--text-5xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    max-inline-size: 20ch;
    text-wrap: balance;
  }

  .about-why__rule {
    margin-block-start: var(--space-6);
    inline-size: var(--space-16);
    block-size: 4px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
  }

  .about-why__body {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-inline-size: 54ch;
  }

  /* Mission and vision, as a definition list because that is what they are.
     They used to occupy a whole band for two sentences. */
  .about-mv {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-8);
    border-block-start: 1px solid var(--color-border);
  }

  .about-mv dt {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-ink);
  }

  .about-mv dd {
    margin: var(--space-2) 0 0;
    font-weight: var(--weight-medium);
    line-height: 1.5;
  }

  /* ---- 2. The survey ----
     Three ratios against a whole, so each is a meter with a figure, not a pie
     and not a one-bar chart. One hue throughout: these are three readings of
     the same thing, not three competing identities, so a categorical palette
     would invent a distinction the data does not have. */
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stat__figure {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .stat__prefix {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Ink, not gold. The figure is text and wears a text colour; the gold lives in
     the meter beside it, which is the mark. */
  .stat__value {
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  :global([dir='rtl']) .stat__value {
    letter-spacing: 0;
  }

  .meter {
    block-size: 8px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-text) 10%, transparent);
    overflow: hidden;
  }

  .meter__fill {
    inline-size: var(--fill);
    block-size: 100%;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    transform-origin: 0 50%;
    transform: scaleX(1);
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global([dir='rtl']) .meter__fill {
    transform-origin: 100% 50%;
  }

  :global(html.reveal-ready) .stat.reveal:not(.is-visible) .meter__fill {
    transform: scaleX(0);
  }

  .stat__label {
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  /* ---- Motion ----
     Each section arrives differently, so the page reads as composed rather than
     as one effect applied five times. All of it hangs off the existing
     `.reveal` / `.is-visible` contract, and all of it multiplies by
     `--motion-scale`, which reduced motion collapses to zero: the travel goes,
     the fades stay at full duration. */

  /* The opening rule draws itself, the same gesture the page-head rule makes on
     every other page, so About opens in the site's own handwriting. */
  .about-why__rule {
    transform: scaleX(1);
    transform-origin: 0 50%;
    transition: transform var(--duration-story) var(--ease-out-expo);
  }

  :global([dir='rtl']) .about-why__rule {
    transform-origin: 100% 50%;
  }

  :global(html.motion-ready) .about-why__rule {
    transform: scaleX(0);
  }

  /* The standards settle: the row arrives, then its chip lands a beat later.
     Two steps rather than one is what makes a list feel assembled instead of
     dropped in. */
  .hold__icon {
    transform: scale(calc(1 - 0.18 * var(--motion-scale)));
    opacity: 0.6;
    transition:
      transform var(--duration-slower) var(--ease-out-expo) 120ms,
      opacity var(--duration-slower) var(--ease-out) 120ms;
  }

  .hold__item.is-visible .hold__icon {
    transform: scale(1);
    opacity: 1;
  }

  /* Faces come in slightly closer than they end up. A small scale on a portrait
     reads as the photo settling rather than as a card sliding, which is the
     difference between warm and mechanical here. */
  .about-team__photo {
    transform: scale(calc(1 + 0.04 * var(--motion-scale)));
    transition: transform var(--duration-story) var(--ease-out-expo);
  }

  .about-team__member.is-visible .about-team__photo {
    transform: scale(1);
  }

  /* A quiet lift on hover, pointer devices only: on touch there is no hover
     state and the transition just delays the tap. */
  @media (hover: hover) and (pointer: fine) {
    .about-team__member {
      transition: transform var(--duration-base) var(--ease-out);
    }

    .about-team__member:hover {
      transform: translateY(calc(-4px * var(--motion-scale)));
    }
  }

  /* The two statements arrive from slightly further than a normal reveal, and
     slower. This is the page's one moment of scale and the motion should agree
     with that rather than treating it like another paragraph. */
  :global(html.reveal-ready) .mv__item.reveal {
    transition-duration: var(--duration-story);
    transition-timing-function: var(--ease-out-expo);
  }

  :global(html.reveal-ready) .mv__item.reveal:not(.is-visible) {
    transform: translateY(calc(40px * var(--motion-scale)));
  }

  @media (prefers-reduced-motion: reduce) {
    .hold__icon,
    .about-team__photo,
    .about-why__rule {
      transition: opacity var(--duration-slower) var(--ease-out);
      transform: none;
    }
  }

  /* ---- 2. What we are for ----
     The page's one moment of scale. Navy is the most emphatic surface in the
     palette and `--color-surface-inverse` exists for exactly this: a navy panel
     inside a light page. Two sentences meant to outlive everything else on the
     site have earned it, and nothing else on this page competes.

     The type is set at display size and the measure kept short, because the
     grandeur is supposed to come from scale and air rather than from decoration. */
  /* AN INVERTED BAND, so every colour in it has to flip with the theme, and
     three of them were not.

     `--color-surface-inverse` is navy on a light page and PAPER on a dark one —
     that is the point of it. But the band was painting `--color-text-on-navy`
     (paper) and `--gold-300` (a light gold for navy grounds) on top, so in dark
     mode it was paper text and pale gold labels on a paper background: the
     whole section, the two sentences meant to outlive every other line on the
     site, was invisible.

     The three inks are local variables set for the light case and swapped in
     dark, rather than three separate overrides scattered down the file. */
  .mv {
    --mv-ink: var(--color-text-on-navy);
    --mv-accent: var(--gold-300);
    --mv-rule: color-mix(in srgb, var(--paper) 28%, transparent);

    margin-block: var(--space-24);
    padding-block: var(--space-32);
    background-color: var(--color-surface-inverse);
    color: var(--mv-ink);
  }

  /* Dark mode inverts the ground to paper, so the band takes the LIGHT theme's
     inks: navy body, and the deep gold that is rated 5.4:1 on paper rather than
     the soft one meant for navy. */
  :global([data-theme='dark']) .mv {
    --mv-ink: var(--navy);
    --mv-accent: var(--gold-800);
    --mv-rule: color-mix(in srgb, var(--navy) 24%, transparent);
  }

  .mv__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .mv__eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--mv-accent);
    margin-block-end: var(--space-12);
  }

  /* `start`, not `center`. The two statements are different lengths, and
     centring them vertically put "Our mission" and "Our vision" on different
     lines, which made a matched pair look like two unrelated blocks. The rule
     between them is centred on its own instead. */
  .mv__pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-16);
    align-items: start;
  }

  .mv__rule {
    align-self: center;
  }

  .mv__item {
    margin: 0;
    display: grid;
    gap: var(--space-5);
    justify-items: center;
  }

  .mv__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--mv-accent);
  }

  .mv__text {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    text-wrap: balance;
    max-inline-size: 20ch;
  }

  /* A drawn divider between the two, not a border: it grows from the middle as
     the pair arrives, which is what ties them together as one statement. */
  .mv__rule {
    inline-size: 1px;
    block-size: var(--space-20);
    background-color: var(--mv-rule);
    transform: scaleY(1);
    transition: transform var(--duration-story) var(--ease-out-expo);
  }

  :global(html.reveal-ready) .mv__rule.reveal:not(.is-visible) {
    transform: scaleY(0);
  }

  /* ---- The standing action ---- */


  /* ---- 3. What we hold to, and what it rules out ---- */
  .hold {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .hold__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }

  .hold__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .hold__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-12);
    block-size: var(--space-12);
    border-radius: var(--radius-md);
    background-color: var(--color-accent-tint);
    color: var(--color-text);
    flex: 0 0 auto;
  }

  .hold__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  .hold__body {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .refuse {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm), var(--rim-light);
  }

  .refuse__heading {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .refuse__list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .refuse__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    line-height: 1.5;
  }

  .refuse__list :global(svg) {
    margin-block-start: 4px;
    color: var(--color-danger);
  }

  /* ---- 4. Team ---- */
  .about-team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .about-team__member {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  /* `block-size: auto` is load-bearing, not tidiness.
     The img carries width="720" height="720", and that height attribute is a
     presentational hint that fixes the used height. `aspect-ratio` only governs
     when one axis is auto, so with inline-size:100% the box rendered 258x720 —
     a 2.8:1 tower — and object-fit:cover then cropped a tall slice out of a
     SQUARE photo, cutting the tops off people's heads. The attributes stay,
     because they are what reserves the right box before the image decodes. */
  .about-team__photo {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
    /* Bias upward: in a head-and-shoulders photo the face sits above centre, so
       a centred crop is the one that clips a forehead. */
    object-position: 50% 30%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin-block-end: var(--space-3);
  }

  .about-team__name {
    font-weight: var(--weight-semibold);
  }

  .about-team__role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .about-team__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    margin-inline-start: calc(-1 * var(--space-3));
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
  }

  .about-team__link:hover {
    color: var(--color-text);
  }

  /* ---- Adaptation ----
     The two-column pairs collapse in a deliberate order: the mascot goes first
     because it is decoration, then the data columns, and the stat row stays
     readable at every step rather than squeezing three meters into a phone. */
  @media (max-width: 63.99rem) {
    .about-why__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .about-why__figure {
      order: -1;
    }

    .hold {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
    }

    .stats {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .mv {
      margin-block: var(--space-16);
