---
/**
 * Who we are.
 *
 * Why -> how -> what, in that order and deliberately. Most about pages open
 * with what the company does, which is the least persuasive thing they have.
 * This one opens with the belief, because the belief is what keeps a sceptical
 * graduate reading past the first screen.
 *
 * NOT here, on purpose: any section about reading transcripts or CVs. That was
 * the superseded "translation engine" pitch and it creeps back every time
 * someone touches this page. The destination and the distance are the story.
 */
import Hud from '../Hud.astro';
import GirihField from '../GirihField.astro';
import GirihTile from '../GirihTile.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

/**
 * The team, from itqan-pitch/build/team.json. Photos are the pre-cropped 720px
 * squares in public/team; the originals run from 400x400 to 720x1280 and a
 * centre crop beheads the tall ones, so they are never re-cropped here.
 */
const team = [
  { slug: 'ahmad', name: 'Ahmad Faraj', nameAr: 'أحمد فرج', role: 'Business Developer', roleAr: 'مطوّر أعمال', url: 'https://www.linkedin.com/in/abujamal/' },
  { slug: 'samin', name: 'Samin Rezaei', nameAr: 'سامين رضائي', role: 'UI/UX Engineer', roleAr: 'مهندسة تجربة وواجهة المستخدم', url: 'https://www.linkedin.com/in/saminrezaei/' },
  { slug: 'amin', name: 'Amin Mohammed', nameAr: 'أمين محمد', role: 'AI Engineer', roleAr: 'مهندس ذكاء اصطناعي', url: 'https://linkedin.com/in/amin-patra/' },
  { slug: 'gheath', name: 'Gheath Wahab', nameAr: 'غياث وهاب', role: 'Software Engineer', roleAr: 'مهندس برمجيات', url: 'https://www.linkedin.com/in/gheath-wahab/' },
];

/**
 * LinkedIn's own mark, inlined. Simple Icons dropped it after a trademark
 * request, so this is the real mark rather than an approximation, drawn in
 * currentColor so it reads as neutral monochrome on both themes instead of
 * being recoloured into Itqan's palette.
 */
const LINKEDIN_PATH = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const howItems = [
  { title: s.about.how1Title, body: s.about.how1Body },
  { title: s.about.how2Title, body: s.about.how2Body },
  { title: s.about.how3Title, body: s.about.how3Body },
];

const refusals = [s.about.refuse1, s.about.refuse2, s.about.refuse3, s.about.refuse4];
---

<!-- The why. The only display-scale moment on the page; everything after it is
     quieter, so the page reads as an argument settling rather than a brochure
     that keeps shouting. -->
<section class="panel panel--navy on-navy about-head">
  <div class="panel__pattern reveal">
    <GirihField held={(row, col) => col + row < 9} />
  </div>

  <div class="container panel__inner about-why">
    <h1 class="display reveal">{s.about.whyHeading}</h1>
    <p class="lede reveal">{s.about.whyBody}</p>
    <div class="about-hud">
      <Hud pose="idle" size="md" loop />
    </div>
  </div>
</section>

<!-- Mission and vision, as two plain statements. -->
<section class="panel panel--paper">
  <div class="container panel__inner about-statements">
    <div class="about-statement reveal">
      <h2 class="about-statement__label">{s.about.missionLabel}</h2>
      <p class="about-statement__text">{s.about.mission}</p>
    </div>
    <div class="about-statement reveal">
      <h2 class="about-statement__label">{s.about.visionLabel}</h2>
      <p class="about-statement__text">{s.about.vision}</p>
    </div>
  </div>
</section>

<!-- How. Three commitments as a sequence you go down, never a card grid. -->
<section class="panel panel--sunken">
  <div class="container panel__inner">
    <h2 class="heading reveal">{s.about.howHeading}</h2>
    <ol class="spine">
      {
        howItems.map((item) => (
          <li class="spine__step reveal">
            <span class="spine__marker">
              <GirihTile name="pentagon" state="set" size={28} />
            </span>
            <div>
              <h3 class="spine__title">{item.title}</h3>
              <p class="spine__body">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- What we found. The one place the site carries numbers, so it carries its
     qualifier in the same breath. -->
<section class="panel panel--paper">
  <div class="container panel__inner">
    <h2 class="heading reveal">{s.about.evidenceHeading}</h2>
    <p class="about-evidence reveal">{s.about.evidenceBody}</p>
    <p class="about-qualifier reveal">{s.about.evidenceQualifier}</p>
    <p class="about-where reveal">{s.about.whereBody}</p>
  </div>
</section>

<!-- What you never pay for, and what we refuse. -->
<section class="panel panel--navy on-navy">
  <div class="panel__pattern" aria-hidden="true">
    <GirihField held={(row, col) => col - row < 4} animate={false} />
  </div>

  <div class="container panel__inner about-pay">
    <div>
      <h2 class="heading reveal">{s.about.payHeading}</h2>
      <p class="lede reveal">{s.about.payBody}</p>
    </div>

    <div class="plaque reveal">
      <h3 class="about-refuse__heading">{s.about.refuseHeading}</h3>
      <ul class="pieces">
        {
          refusals.map((line) => (
            <li class="piece piece--open">
              <GirihTile name="rhombus" state="open" size={24} />
              <span class="piece__name">{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- The team. Name, role, a link out. No description line per person. -->
<section class="panel panel--paper">
  <div class="container panel__inner">
    <h2 class="heading reveal">{s.about.teamHeading}</h2>
    <ul class="about-team stagger">
      {
        team.map((member) => {
          const name = locale === 'ar' ? member.nameAr : member.name;
          const role = locale === 'ar' ? member.roleAr : member.role;
          return (
            <li class="about-team__member reveal">
              <img
                class="about-team__photo"
                src={`/team/${member.slug}.jpg`}
                alt=""
                width="720"
                height="720"
                loading="lazy"
                decoding="async"
              />
              <p class="about-team__name"><bdi>{name}</bdi></p>
              <p class="about-team__role">{role}</p>
              <a
                class="about-team__link"
                href={member.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.about.linkedinLabel.replace('{name}', name)}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={LINKEDIN_PATH} />
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<section class="panel panel--navy panel--closing on-navy">
  <div class="panel__pattern panel__pattern--centred" aria-hidden="true">
    <GirihField held={() => true} radius={120} />
  </div>
  <div class="container panel__inner closing">
    <h2 class="heading reveal">{s.home.closing.heading}</h2>
    <div class="actions">
      <a class="button button--primary button--arrow" href={`${base}/signup/`}>
        <span>{s.actions.signup}</span>
        <svg class="button__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .about-head {
    padding-block: 0;
  }

  .about-why {
    position: relative;
    padding-block: var(--space-32) var(--space-24);
  }

  .about-hud {
    margin-block-start: var(--space-10);
  }

  .about-statements {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
  }

  .about-statement__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-ink);
  }

  .about-statement__text {
    margin-block-start: var(--space-4);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    text-wrap: balance;
  }

  .about-evidence {
    margin-block-start: var(--space-8);
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-text-muted);
    max-inline-size: var(--measure);
  }

  .about-qualifier {
    margin-block-start: var(--space-4);
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--color-border-accent);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-inline-size: 48ch;
  }

  .about-where {
    margin-block-start: var(--space-10);
    color: var(--color-text-muted);
    max-inline-size: var(--measure);
    line-height: 1.65;
  }

  .about-pay {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: start;
  }

  .about-refuse__heading {
    margin-block-end: var(--space-5);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .about-team {
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .about-team__member {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  /* A girih decagon clip would crop the faces badly at this size, so the photo
     keeps a soft rectangle and the gold hairline carries the world instead. */
  .about-team__photo {
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin-block-end: var(--space-3);
  }

  .about-team__name {
    font-weight: var(--weight-semibold);
  }

  .about-team__role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .about-team__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    margin-inline-start: calc(-1 * var(--space-3));
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
  }

  .about-team__link:hover {
    color: var(--color-text);
  }

  @media (max-width: 63.99rem) {
    .about-statements,
    .about-pay {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
    }

    .about-team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 51.99rem) {
    .about-why {
      padding-block: var(--space-20) var(--space-16);
    }

    .about-statement__text {
      font-size: var(--text-xl);
    }
  }

  @media (max-width: 29.99rem) {
    .about-team {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
