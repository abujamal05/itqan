---
/**
 * Who we are.
 *
 * Structured Why -> How -> What (Sinek's golden circle), deliberately and in
 * that order. Most about pages open with what the company does, which is the
 * least persuasive thing they have; this one opens with the belief, because the
 * belief is what keeps a sceptical graduate reading past the first screen.
 *
 * Two things the layout is doing on purpose:
 *
 *  - The WHY is the only full-width, large-type moment on the page. Everything
 *    after it is quieter and more structured, so the page reads as an argument
 *    that settles rather than a brochure that keeps shouting.
 *  - The three HOW statements and the three WHAT statements are set as parallel
 *    rows, not cards. Cards would make them feel like features to compare; they
 *    are commitments and a sequence, which read better as a list you go down.
 *
 * NOT here, on purpose: any section about reading transcripts or CVs. That was
 * the old "translation engine" pitch and it creeps back in every time someone
 * touches this page. Reading the documents is one step inside step one. The
 * destination and the distance are the story; the documents are plumbing.
 */
import Hud from '../Hud.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

/**
 * The team, from itqan-pitch/build/team.json. Photos are the pre-cropped 720px
 * squares copied to public/team; the originals run from 400x400 to 720x1280 and
 * a centre crop beheads the tall ones, so they are never re-cropped here.
 */
const team = [
  { slug: 'ahmad', name: 'Ahmad Faraj', nameAr: 'أحمد فرج', role: 'Business Developer', roleAr: 'مطوّر أعمال', url: 'https://www.linkedin.com/in/abujamal/' },
  { slug: 'samin', name: 'Samin Rezaei', nameAr: 'سامين رضائي', role: 'UI/UX Engineer', roleAr: 'مهندسة تجربة وواجهة المستخدم', url: 'https://www.linkedin.com/in/saminrezaei/' },
  { slug: 'amin', name: 'Amin Mohammed', nameAr: 'أمين محمد', role: 'AI Engineer', roleAr: 'مهندس ذكاء اصطناعي', url: 'https://linkedin.com/in/amin-patra/' },
  { slug: 'gheath', name: 'Gheath Wahab', nameAr: 'غياث وهاب', role: 'Software Engineer', roleAr: 'مهندس برمجيات', url: 'https://www.linkedin.com/in/gheath-wahab/' },
];

/**
 * LinkedIn's own mark, inlined.
 *
 * The brief pointed at Simple Icons, but that set no longer carries LinkedIn:
 * it was removed after a trademark request, so `npm i simple-icons` installs
 * 3,453 icons and not this one. This is LinkedIn's actual mark rather than an
 * approximation, drawn in currentColor so it reads as a neutral monochrome on
 * both themes, which the brief allows and which avoids recolouring a trademark
 * into Itqan's palette.
 */
const LINKEDIN_PATH = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const howItems = [
  { title: s.about.how1Title, body: s.about.how1Body },
  { title: s.about.how2Title, body: s.about.how2Body },
  { title: s.about.how3Title, body: s.about.how3Body },
];

const whatItems = [
  { title: s.about.what1Title, body: s.about.what1Body },
  { title: s.about.what2Title, body: s.about.what2Body },
  { title: s.about.what3Title, body: s.about.what3Body },
];

const refusals = [s.about.refuse1, s.about.refuse2, s.about.refuse3, s.about.refuse4];
---

<!-- WHY. The belief, and the only large-type moment on the page. -->
<section class="about-why">
  <div class="container about-why__grid">
    <div class="about-why__copy">
      <p class="eyebrow reveal">{s.about.eyebrow}</p>
      <h1 class="about-why__heading reveal">{s.about.whyHeading}</h1>
      <div class="about-why__rule reveal" aria-hidden="true"></div>
      <p class="about-why__body reveal">{s.about.whyBody}</p>
    </div>
    <div class="about-why__figure reveal">
      <Hud pose="idle" size="lg" loop eager />
    </div>
  </div>
</section>

<!-- Mission and vision, as a matched pair. -->
<section class="section section--sunken">
  <div class="container">
    <div class="about-statements">
      <div class="about-statement reveal">
        <p class="eyebrow">{s.about.missionLabel}</p>
        <p class="about-statement__text">{s.about.mission}</p>
      </div>
      <div class="about-statement reveal">
        <p class="eyebrow">{s.about.visionLabel}</p>
        <p class="about-statement__text">{s.about.vision}</p>
      </div>
    </div>
  </div>
</section>

<!-- HOW. Three commitments, as parallel rows. -->
<section class="section">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.howEyebrow}</p>
      <h2 class="section__heading">{s.about.howHeading}</h2>
    </div>
    <ul class="about-list stagger">
      {
        howItems.map((item) => (
          <li class="about-list__item reveal">
            <span class="about-list__mark" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"></path></svg>
            </span>
            <div>
              <h3 class="about-list__title">{item.title}</h3>
              <p class="about-list__body">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- WHAT. The three things, in order, numbered because the order is real. -->
<section class="section section--sunken">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.whatEyebrow}</p>
      <h2 class="section__heading">{s.about.whatHeading}</h2>
    </div>
    <ol class="about-steps stagger">
      {
        whatItems.map((item, i) => (
          <li class="about-steps__item reveal">
            <span class="about-steps__num num" aria-hidden="true">{i + 1}</span>
            <p class="about-steps__text">
              <strong>{item.title}</strong> {item.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- The evidence. Never presented as anything but an early sample. -->
<section class="section">
  <div class="container about-evidence">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.evidenceEyebrow}</p>
      <h2 class="section__heading">{s.about.evidenceHeading}</h2>
    </div>
    <p class="about-evidence__body reveal">{s.about.evidenceBody}</p>
    <p class="about-evidence__qualifier reveal">{s.about.evidenceQualifier}</p>
  </div>
</section>

<!-- Where we sit, and what is never paid for. -->
<section class="section section--sunken">
  <div class="container about-pair">
    <div class="reveal">
      <p class="eyebrow">{s.about.whereEyebrow}</p>
      <p class="about-pair__body">{s.about.whereBody}</p>
    </div>
    <div class="reveal">
      <p class="eyebrow">{s.about.payEyebrow}</p>
      <p class="about-pair__body">{s.about.payBody}</p>
    </div>
  </div>
</section>

<!-- The refusals. Short, plain, and deliberately unadorned. -->
<section class="section">
  <div class="container">
    <div class="section__head reveal">
      <h2 class="section__heading">{s.about.refuseHeading}</h2>
    </div>
    <ul class="about-refusals stagger">
      {
        refusals.map((line) => (
          <li class="about-refusals__item reveal">
            <span class="about-refusals__mark" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </span>
            <span>{line}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- The team. Name, role, and a link out. No description line per person. -->
<section class="section section--sunken">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.teamEyebrow}</p>
      <h2 class="section__heading">{s.about.teamHeading}</h2>
    </div>
    <ul class="about-team stagger">
      {
        team.map((member) => {
          const name = locale === 'ar' ? member.nameAr : member.name;
          const role = locale === 'ar' ? member.roleAr : member.role;
          return (
            <li class="about-team__card reveal">
              <img
                class="about-team__photo"
                src={`/team/${member.slug}.jpg`}
                alt=""
                width="720"
                height="720"
                loading="lazy"
                decoding="async"
              />
              <p class="about-team__name"><bdi>{name}</bdi></p>
              <p class="about-team__role">{role}</p>
              <a
                class="about-team__link"
                href={member.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.about.linkedinLabel.replace('{name}', name)}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={LINKEDIN_PATH}></path>
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<!-- Closing call to action, matching the home page's. -->
<section class="section section--closing">
  <div class="container">
    <div class="closing reveal">
      <div class="closing__bg" aria-hidden="true"></div>
      <h2>{s.home.closing.heading}</h2>
      <a class="button button--primary button--arrow" href={`${base}/signup/`}>
        <span>{s.actions.signup}</span>
        <svg class="button__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ---- WHY: the one large moment ---- */
  .about-why {
    position: relative;
    padding-block: var(--space-16) var(--space-12);
    overflow-x: clip;
  }

  .about-why__grid {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .about-why__copy {
    flex: 1 1 34rem;
  }

  .about-why__figure {
    flex: 0 0 auto;
  }

  .about-why__heading {
    margin-block-start: var(--space-5);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    /* Long enough to carry weight, short enough to stay one thought per line. */
    max-inline-size: 22ch;
  }

  .about-why__rule {
    margin-block-start: var(--space-6);
    inline-size: var(--space-16);
    block-size: 4px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    transform: scaleX(1);
    transform-origin: 0 50%;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global([dir='rtl']) .about-why__rule {
    transform-origin: 100% 50%;
  }

  :global(html.reveal-ready) .about-why__rule.reveal:not(.is-visible) {
    transform: scaleX(0);
  }

  .about-why__body {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-inline-size: 58ch;
  }

  /* The mascot is decoration here, and the first thing dropped on a phone:
     the belief is what has to land, and it lands faster without him. */
  @media (max-width: 51.99rem) {
    .about-why__figure { display: none; }
    .about-why { padding-block: var(--space-10) var(--space-8); }
    .about-why__heading { font-size: var(--text-3xl); }
  }

  /* ---- Mission and vision ---- */
  .about-statements {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }

  @media (max-width: 51.99rem) {
    .about-statements { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  /* A rule on the reading-start edge, so the pair reads as two quotations of
     intent rather than two more cards. */
  .about-statement {
    border-inline-start: 3px solid var(--color-accent);
    padding-inline-start: var(--space-5);
  }

  .about-statement__text {
    margin-block-start: var(--space-3);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: 1.5;
  }

  /* ---- HOW: parallel rows ---- */
  .about-list,
  .about-refusals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-inline-size: 46rem;
  }

  .about-list__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .about-list__mark {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent-tint);
    color: var(--color-accent-hover);
  }

  .about-list__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-2);
  }

  .about-list__body {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ---- WHAT: numbered, because the order is real ---- */
  .about-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-inline-size: 46rem;
    counter-reset: step;
  }

  .about-steps__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .about-steps__num {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
    font-weight: var(--weight-semibold);
  }

  .about-steps__text {
    font-size: var(--text-lg);
    line-height: 1.6;
    padding-block-start: var(--space-1);
  }

  .about-steps__text strong {
    font-weight: var(--weight-semibold);
  }

  /* ---- Evidence ---- */
  .about-evidence__body {
    margin-block-start: var(--space-5);
    font-size: var(--text-lg);
    line-height: 1.7;
    max-inline-size: 52rem;
  }

  /* The qualifier is not fine print: it is the reason the numbers above are
     allowed to be shown at all, so it sits in a box rather than a footnote. */
  .about-evidence__qualifier {
    margin-block-start: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-inline-start: 3px solid var(--color-border-strong);
    background-color: var(--color-surface-sunken);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-sm);
    max-inline-size: 52rem;
  }

  /* ---- Where we sit / what is never paid for ---- */
  .about-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-10);
  }

  @media (max-width: 51.99rem) {
    .about-pair { grid-template-columns: 1fr; gap: var(--space-8); }
  }

  .about-pair__body {
    margin-block-start: var(--space-3);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* ---- Refusals ---- */
  .about-refusals { gap: var(--space-4); }

  .about-refusals__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
  }

  .about-refusals__mark {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 28px;
    block-size: 28px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-sunken);
    color: var(--color-text);
  }

  /* ---- Team ---- */
  .about-team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 63.99rem) {
    .about-team { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 26rem) {
    .about-team { grid-template-columns: 1fr; }
  }

  .about-team__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-4);
  }

  .about-team__photo {
    inline-size: 96px;
    block-size: 96px;
    border-radius: var(--radius-full);
    object-fit: cover;
    margin-block-end: var(--space-2);
    background-color: var(--color-surface-sunken);
  }

  .about-team__name {
    font-weight: var(--weight-semibold);
  }

  .about-team__role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* A real link at the touch floor, not a decorative glyph. */
  .about-team__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    margin-block-start: var(--space-1);
    border-radius: var(--radius-full);
    color: var(--color-text);
    transition:
      background-color var(--duration-fast) var(--ease-hover),
      color var(--duration-fast) var(--ease-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-team__link:hover {
      background-color: var(--color-surface-sunken);
      color: var(--color-accent-hover);
    }
  }
</style>
