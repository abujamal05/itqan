---
/**
 * Who we are. FIVE sections, down from eight.
 *
 * What was cut and why:
 *  - "What Itqan does" repeated the home page's four steps. Said once, on home.
 *  - Mission and vision were a section of their own holding two sentences; they
 *    now sit under the opening statement, which is where a reader looks for them.
 *  - "Where we sit" was a paragraph of institutional detail (UTAS, MTCIT, Khuta)
 *    that answers a question no job seeker is asking. Reduced to one line.
 *  - "How we do it" and "What we refuse" were two sections making one argument:
 *    here is the standard we hold, here is what that rules out. Now one section,
 *    two columns.
 *
 * The survey is the page's centre of gravity now, because it is the only real
 * evidence on it. It is rendered as three meters rather than a paragraph, and
 * every figure is a ratio in words: the sample only supports "roughly two
 * thirds", so printing "67%" would be inventing precision the data has not got.
 *
 * ONE Hud, in the opening section, and none below it.
 */
import { Icon } from 'astro-icon/components';
import Hud from '../Hud.astro';
import Shot from '../Shot.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

/**
 * The team, from itqan-pitch/build/team.json. Photos are the pre-cropped 720px
 * squares in public/team; the originals run from 400x400 to 720x1280 and a
 * centre crop beheads the tall ones, so they are never re-cropped here.
 */
const team = [
  { slug: 'ahmad', name: 'Ahmad Faraj', nameAr: 'أحمد فرج', role: 'Business Developer', roleAr: 'مطوّر أعمال', url: 'https://www.linkedin.com/in/abujamal/' },
  { slug: 'samin', name: 'Samin Rezaei', nameAr: 'سامين رضائي', role: 'UI/UX Engineer', roleAr: 'مهندسة تجربة وواجهة المستخدم', url: 'https://www.linkedin.com/in/saminrezaei/' },
  { slug: 'amin', name: 'Amin Mohammed', nameAr: 'أمين محمد', role: 'AI Engineer', roleAr: 'مهندس ذكاء اصطناعي', url: 'https://linkedin.com/in/amin-patra/' },
  { slug: 'gheath', name: 'Gheath Wahab', nameAr: 'غياث وهاب', role: 'Software Engineer', roleAr: 'مهندس برمجيات', url: 'https://www.linkedin.com/in/gheath-wahab/' },
];

const holds = [
  { icon: 'ph:chart-bar-duotone', title: s.about.how1Title, body: s.about.how1Body },
  { icon: 'ph:seal-check-duotone', title: s.about.how2Title, body: s.about.how2Body },
  { icon: 'ph:shield-check-duotone', title: s.about.how3Title, body: s.about.how3Body },
];

const refusals = [s.about.refuse1, s.about.refuse2, s.about.refuse3, s.about.refuse4];
---

<!-- 1. The belief, with mission and vision folded in beneath it. -->
<section class="about-why">
  <div class="container about-why__grid">
    <div class="about-why__copy">
      <p class="eyebrow reveal">{s.about.eyebrow}</p>
      <h1 class="about-why__heading reveal">{s.about.whyHeading}</h1>
      <div class="about-why__rule reveal" aria-hidden="true"></div>
      <p class="about-why__body reveal">{s.about.whyBody}</p>

      <dl class="about-mv reveal">
        <div>
          <dt>{s.about.missionLabel}</dt>
          <dd>{s.about.mission}</dd>
        </div>
        <div>
          <dt>{s.about.visionLabel}</dt>
          <dd>{s.about.vision}</dd>
        </div>
      </dl>
    </div>

    <div class="about-why__figure reveal">
      <Hud pose="idle" size="lg" loop eager />
    </div>
  </div>
</section>

<!-- 2. The evidence. The page's centre of gravity, and the only real data on it.
        Meters rather than a paragraph, because a proportion is a shape. -->
<section class="section section--sunken">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.evidenceEyebrow}</p>
      <h2 class="section__heading">{s.about.stats.heading}</h2>
    </div>

    <ul class="stats stagger">
      {
        s.about.stats.items.map((item) => (
          <li class="stat reveal">
            {/* The accessible name carries the whole finding as a sentence, so a
                screen reader never has to reassemble it from a figure and a
                fragment sitting in different elements. */}
            <div
              class="stat__figure"
              role="img"
              aria-label={`${item.prefix} ${item.figure} ${item.label}`}
            >
              <span class="stat__prefix" aria-hidden="true">{item.prefix}</span>
              <span class="stat__value" aria-hidden="true">{item.figure}</span>
            </div>

            {/* The meter encodes the approximation; the number behind it is never
                printed, because the sample does not support that precision. */}
            <div class="meter" aria-hidden="true">
              <div class="meter__fill" style={`--fill: ${item.value}%`}></div>
            </div>

            <p class="stat__label" aria-hidden="true">{item.label}</p>
          </li>
        ))
      }
    </ul>

    <p class="stats__note reveal">
      <Icon name="ph:warning" width="16" height="16" aria-hidden="true" />
      <span>{s.about.stats.note}</span>
    </p>
  </div>
</section>

<!-- 3. The standard we hold, and what it rules out. One argument, two columns. -->
<section class="section">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.howEyebrow}</p>
      <h2 class="section__heading">{s.about.holdHeading}</h2>
    </div>

    <div class="hold">
      <ul class="hold__list stagger">
        {
          holds.map((item) => (
            <li class="hold__item reveal">
              <span class="hold__icon" aria-hidden="true">
                <Icon name={item.icon} width="24" height="24" />
              </span>
              <div>
                <h3 class="hold__title">{item.title}</h3>
                <p class="hold__body">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="refuse reveal">
        <h3 class="refuse__heading">{s.about.refuseHeading}</h3>
        <ul class="refuse__list">
          {
            refusals.map((line) => (
              <li>
                <Icon name="ph:x" width="16" height="16" aria-hidden="true" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
        <p class="refuse__pay">{s.about.payBody}</p>
      </div>
    </div>
  </div>
</section>

<!-- 4. The team, and where we sit, together: both answer "who is behind this". -->
<section class="section section--sunken">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.about.teamEyebrow}</p>
      <h2 class="section__heading">{s.about.teamHeading}</h2>
    </div>

    <ul class="about-team stagger">
      {
        team.map((member) => {
          const name = locale === 'ar' ? member.nameAr : member.name;
          const role = locale === 'ar' ? member.roleAr : member.role;
          return (
            <li class="about-team__member reveal">
              <img
                class="about-team__photo"
                src={`/team/${member.slug}.jpg`}
                alt=""
                width="720"
                height="720"
                loading="lazy"
                decoding="async"
              />
              <p class="about-team__name"><bdi>{name}</bdi></p>
              <p class="about-team__role">{role}</p>
              <a
                class="about-team__link"
                href={member.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.about.linkedinLabel.replace('{name}', name)}
              >
                <Icon name="ph:linkedin-logo" width="18" height="18" aria-hidden="true" />
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="about-where reveal">
      <Icon name="ph:map-pin" width="16" height="16" aria-hidden="true" />
      <span>{s.about.whereBody}</span>
    </p>
  </div>
</section>

<!-- 5. The product itself, then the one action. Showing the thing beats another
        paragraph about it. -->
<section class="section">
  <div class="container about-close">
    <div class="about-close__copy reveal">
      <h2 class="section__heading">{s.home.closing.heading}</h2>
      <p class="about-close__body">{s.home.closing.body}</p>
      <a class="button button--primary button--arrow" href={`${base}/signup/`}>
        <span>{s.actions.signup}</span>
        <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
      </a>
    </div>
    <Shot name="dashboard" alt={s.about.mission} class="reveal" />
  </div>
</section>

<style>
  /* ---- 1. The opening ---- */
  .about-why {
    padding-block: var(--space-20) var(--space-16);
  }

  .about-why__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-12);
    align-items: center;
  }

  .about-why__heading {
    margin-block-start: var(--space-3);
    font-size: clamp(var(--text-4xl), 2.6vw + 1.25rem, var(--text-5xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    max-inline-size: 20ch;
    text-wrap: balance;
  }

  .about-why__rule {
    margin-block-start: var(--space-6);
    inline-size: var(--space-16);
    block-size: 4px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
  }

  .about-why__body {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-inline-size: 54ch;
  }

  /* Mission and vision, as a definition list because that is what they are.
     They used to occupy a whole band for two sentences. */
  .about-mv {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-8);
    border-block-start: 1px solid var(--color-border);
  }

  .about-mv dt {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-ink);
  }

  .about-mv dd {
    margin: var(--space-2) 0 0;
    font-weight: var(--weight-medium);
    line-height: 1.5;
  }

  /* ---- 2. The survey ----
     Three ratios against a whole, so each is a meter with a figure, not a pie
     and not a one-bar chart. One hue throughout: these are three readings of
     the same thing, not three competing identities, so a categorical palette
     would invent a distinction the data does not have. */
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stat__figure {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .stat__prefix {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Ink, not gold. The figure is text and wears a text colour; the gold lives in
     the meter beside it, which is the mark. */
  .stat__value {
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  :global([dir='rtl']) .stat__value {
    letter-spacing: 0;
  }

  .meter {
    block-size: 8px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-text) 10%, transparent);
    overflow: hidden;
  }

  .meter__fill {
    inline-size: var(--fill);
    block-size: 100%;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    transform-origin: 0 50%;
    transform: scaleX(1);
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global([dir='rtl']) .meter__fill {
    transform-origin: 100% 50%;
  }

  :global(html.reveal-ready) .stat.reveal:not(.is-visible) .meter__fill {
    transform: scaleX(0);
  }

  .stat__label {
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  /* The qualifier is attached to the data, not buried at the foot of the page.
     A number without its sample size is the thing this product exists to argue
     against. */
  .stats__note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-block-start: var(--space-10);
    padding: var(--space-4) var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-inline-size: 64ch;
  }

  .stats__note :global(svg) {
    flex: 0 0 auto;
    margin-block-start: 2px;
    color: var(--color-accent-ink);
  }

  /* ---- 3. What we hold to, and what it rules out ---- */
  .hold {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .hold__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }

  .hold__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .hold__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-12);
    block-size: var(--space-12);
    border-radius: var(--radius-md);
    background-color: var(--color-accent-tint);
    color: var(--color-text);
    flex: 0 0 auto;
  }

  .hold__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  .hold__body {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .refuse {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm), var(--rim-light);
  }

  .refuse__heading {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .refuse__list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .refuse__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    line-height: 1.5;
  }

  .refuse__list :global(svg) {
    margin-block-start: 4px;
    color: var(--color-danger);
  }

  .refuse__pay {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ---- 4. Team ---- */
  .about-team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .about-team__member {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  .about-team__photo {
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin-block-end: var(--space-3);
  }

  .about-team__name {
    font-weight: var(--weight-semibold);
  }

  .about-team__role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .about-team__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    margin-inline-start: calc(-1 * var(--space-3));
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
  }

  .about-team__link:hover {
    color: var(--color-text);
  }

  .about-where {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-block-start: var(--space-10);
    color: var(--color-text-muted);
    max-inline-size: 62ch;
    line-height: 1.6;
  }

  .about-where :global(svg) {
    flex: 0 0 auto;
    margin-block-start: 3px;
    color: var(--color-accent-ink);
  }

  /* ---- 5. Close ---- */
  .about-close {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: center;
  }

  .about-close__body {
    margin-block: var(--space-4) var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  /* ---- Adaptation ----
     The two-column pairs collapse in a deliberate order: the mascot goes first
     because it is decoration, then the data columns, and the stat row stays
     readable at every step rather than squeezing three meters into a phone. */
  @media (max-width: 63.99rem) {
    .about-why__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .about-why__figure {
      order: -1;
    }

    .hold,
    .about-close {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
    }

    .stats {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    /* On one column the figure and its meter read better side by side than
       stacked: the meter becomes a row-length comparison down the page. */
    .stat {
      display: grid;
      grid-template-columns: minmax(7rem, auto) minmax(0, 1fr);
      column-gap: var(--space-6);
      row-gap: var(--space-3);
      align-items: center;
    }

    .stat__figure {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .stat .meter {
      grid-column: 2;
    }

    .stat__label {
      grid-column: 2;
      grid-row: 2;
    }

    .about-team {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .about-mv {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .stat {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-3);
    }

    .stat .meter,
    .stat__label {
      grid-column: 1;
    }

    .stat__label {
      grid-row: auto;
    }

    .stat__value {
      font-size: var(--text-4xl);
    }
  }
</style>
