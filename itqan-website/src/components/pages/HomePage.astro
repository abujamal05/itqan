  }

  .tcard__connector {
    color: var(--color-accent);
    inline-size: 96px;
    max-inline-size: 18vw;
  }

  .tcard__connector svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  :global([dir='rtl']) .tcard__connector svg {
    transform: scaleX(-1);
  }

  .tcard__why {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  .tcard__why-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    margin-block-end: var(--space-2);
  }

  .tcard__why-label svg {
    color: var(--color-accent-ink);
  }

  .tcard__why p {
    line-height: 1.6;
  }

  .example__note {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 39.99rem) {
    .tcard__row {
      grid-template-columns: 1fr;
      justify-items: stretch;
      gap: var(--space-3);
    }
    /* Square box, and the arrow rotated inside it.
       The container used to be 40x12 (the svg's own ratio) while the rotated
       arrow drew 12x40, so 14px of it hung out of the layout box top and bottom
       and crossed into a 12px gap — the arrowhead sat on the panel below it.
       A square cell is exactly as tall as the rotated art. */
    .tcard__connector {
      inline-size: 40px;
      block-size: 40px;
      max-inline-size: none;
      justify-self: center;
      display: grid;
      place-items: center;
    }
    .tcard__connector svg {
      inline-size: 40px;
      transform: rotate(90deg);
    }
    /* Down the page in BOTH directions. `rotate(90deg) scaleX(-1)` applies the
       flip first, so the Arabic arrow was rotated from pointing left and ended
       up pointing UP — back at the course it had just come from. Vertical flow
       has no reading direction to mirror; the plain rotation is correct for
       both, and the dot stays at the top where the source is. */
    :global([dir='rtl']) .tcard__connector svg {
      transform: rotate(90deg);
    }
  }

