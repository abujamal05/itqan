    max-inline-size: 48rem;
  }

  .tcard__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .tcard__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-sunken);
  }

  .tcard__panel--to {
    background-color: var(--color-accent-tint);
  }

  .tcard__label {
