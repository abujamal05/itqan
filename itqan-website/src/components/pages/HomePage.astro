---
/**
 * Home.
 *
 * Six beats, paced so a dense passage always earns a quiet one:
 *   navy hero (construction) -> paper pain (quiet, one line at title scale)
 *   -> sunken spine (the four questions, dense) -> navy open edge (the proof)
 *   -> paper questions (quiet) -> navy close (the anchor).
 *
 * Hud appears once, in the hero. He is fenced out of the open-edge panel and
 * everything below it, because those surfaces show a judgement about a person.
 */
import Hud from '../Hud.astro';
import GirihField from '../GirihField.astro';
import GirihTile from '../GirihTile.astro';
import { tile, type TileName } from '../../lib/girih';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

/* One tile per question, in the order the set introduces them. The marks are
   real girih tiles rather than picked icons, so a mark means "a piece" and the
   four marks differ because the four pieces do. */
const stepTiles: TileName[] = ['decagon', 'pentagon', 'hexagon', 'bowtie'];

/* The rhombus turns to sit in place when an answer opens. */
const rhombus = tile('rhombus', 9);
---

<!-- 1. Hero. The pattern fills the panel and is masked back off the type, so
     the headline sits in the open half and the construction fills the other. -->
<section class="panel panel--navy on-navy hero-panel">
  <div class="panel__pattern reveal">
    <GirihField held={(row, col) => col + row < 9} />
  </div>

  <div class="container panel__inner hero">
    <h1 class="display reveal">{s.home.hero.heading}</h1>
    <p class="lede reveal">{s.home.hero.sub}</p>
    <div class="actions reveal">
      <a class="button button--primary button--arrow" href={`${base}/signup/`}>
        <span>{s.actions.signup}</span>
        <svg class="button__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
      </a>
      <a class="button button--secondary" href={`${base}/proof/`}>{s.actions.seeWorking}</a>
    </div>

    <div class="hero__mascot">
      <Hud pose="flying-in" then="idle" size="lg" eager />
    </div>
  </div>
</section>

<!-- 2. The pain. One line, at title scale, with air around it. The quiet beat
     between two dense ones. -->
<section class="panel panel--paper pain">
  <div class="container panel__inner">
    <h2 class="title reveal">{s.home.pain.heading}</h2>
    <p class="pain__body reveal">{s.home.pain.body}</p>
  </div>
</section>

<!-- 3. The four questions, laid along one strap. -->
<section class="panel panel--sunken">
  <div class="container panel__inner">
    <h2 class="heading reveal">{s.home.build.heading}</h2>

    <ol class="spine">
      {
        s.home.build.steps.map((step, i) => (
          <li class="spine__step reveal">
            <span class="spine__marker">
              <GirihTile name={stepTiles[i]} state="set" size={30} />
            </span>
            <div>
              <h3 class="spine__title">{step.title}</h3>
              <p class="spine__body">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="actions">
      <a class="strap-link" href={`${base}/how-it-works/`}>{s.chat.forks[0].linkLabel}</a>
    </div>
  </div>
</section>

<!-- 4. The open edge. The site's one demonstration: a piece Itqan can evidence
     is set and closed, a piece it cannot is an outline with nothing in it. -->
<section class="panel panel--navy on-navy">
  <div class="panel__pattern" aria-hidden="true">
    <GirihField held={(row, col) => col - row < 4} animate={false} />
  </div>

  <div class="container panel__inner edge">
    <div class="edge__copy">
      <h2 class="heading reveal">{s.home.openEdge.heading}</h2>
      <p class="lede reveal">{s.home.openEdge.body}</p>
      <div class="actions">
        <a class="strap-link" href={`${base}/proof/`}>{s.home.openEdge.link}</a>
      </div>
    </div>

    <div class="edge__demo plaque reveal">
      <p class="edge__role">{s.home.openEdge.roleLabel}</p>
      <ul class="pieces">
        {
          s.home.openEdge.pieces.map((piece) => (
            <li class:list={['piece', piece.state === 'open' && 'piece--open']}>
              <GirihTile
                name={piece.state === 'set' ? 'pentagon' : 'rhombus'}
                state={piece.state === 'set' ? 'set' : 'open'}
                size={26}
              />
              <span class="piece__name">{piece.name}</span>
              <span class="piece__state">
                {piece.state === 'set' ? s.home.openEdge.setLabel : s.home.openEdge.openLabel}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="edge__note">{s.home.openEdge.note}</p>
    </div>
  </div>
</section>

<!-- 5. Questions. Quiet, and the last thing between a visitor and the action. -->
<section class="panel panel--paper">
  <div class="container panel__inner">
    <h2 class="heading reveal">{s.home.faq.heading}</h2>
    <div class="faq">
      {
        s.home.faq.items.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{item.q}</span>
              <svg
                class="faq__mark"
                viewBox={rhombus.viewBox}
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d={rhombus.outline} />
              </svg>
            </summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- 6. The close. A completed rosette behind a single action. -->
<section class="panel panel--navy panel--closing on-navy">
  <div class="panel__pattern panel__pattern--centred reveal">
    <GirihField held={() => true} radius={120} />
  </div>

  <div class="container panel__inner closing">
    <h2 class="title reveal">{s.home.closing.heading}</h2>
    <p class="lede reveal">{s.home.closing.body}</p>
    <div class="actions">
      <a class="button button--primary button--arrow" href={`${base}/signup/`}>
        <span>{s.actions.signup}</span>
        <svg class="button__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* The hero panel carries the deepest ground on the page, so the pattern in it
     reads at architectural scale rather than as a texture. */
  .hero-panel {
    padding-block: 0;
  }

  .pain {
    padding-block: var(--space-32);
  }

  .pain__body {
    margin-block-start: var(--space-6);
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-inline-size: 38ch;
  }

  /* The demonstration sits beside the claim rather than under it, so the words
     and the thing they describe are read together. */
  .edge {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-16);
    align-items: center;
  }

  .edge__role {
    margin-block-end: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
  }

  .edge__note {
    margin-block-start: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-inline-size: 46ch;
  }

  @media (max-width: 63.99rem) {
    .edge {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
    }
  }

  @media (max-width: 51.99rem) {
    .pain {
      padding-block: var(--space-20);
    }

    .pain__body {
      font-size: var(--text-lg);
    }
  }
</style>
