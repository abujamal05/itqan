---
import { Icon } from 'astro-icon/components';
import Hud from '../Hud.astro';
import Shot from '../Shot.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const base = `/${locale}`;

/* One Phosphor duotone icon per question. Duotone is the point: it carries navy
   AND gold, so the icon uses the brand palette instead of being a grey stroke.
   Meaning never rides on the icon alone; each sits above its own heading. */
const stepIcons = [
  'ph:file-text-duotone',      // where you stand: what you already have
  'ph:target-duotone',         // which role to aim for
  'ph:path-duotone',           // the shortest path
  'ph:briefcase-duotone',      // jobs you can apply to now
];
---

<!-- 1. Hero. Hud flies in once, then idles. Evidence surfaces stay away from him. -->
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title reveal">{s.home.hero.heading}</h1>
      <div class="hero__rule reveal" aria-hidden="true"></div>
      <p class="hero__sub reveal">{s.home.hero.sub}</p>
      {/* The pain used to be a section of its own holding one sentence. It reads
          better here, immediately under the promise it is the counterweight to,
          and it buys the page a whole section back. */}
      <p class="hero__pain reveal">{s.home.pain.body}</p>
      <div class="hero__actions reveal">
        <a class="button button--primary button--arrow" href={`${base}/signup/`}>
          <span>{s.actions.signup}</span>
          <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
        </a>
        <a class="button button--secondary" href={`${base}/proof/`}>{s.home.hero.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero__figure reveal">
      <Hud pose="flying-in" then="idle" size="lg" eager />
    </div>
  </div>
</section>

<!-- 3. The four questions, linked by the gold thread. -->
<section class="section section--sunken">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{s.home.build.eyebrow}</p>
      <h2 class="section__heading">{s.home.build.heading}</h2>
    </div>
    <ol class="steps stagger">
      <span class="steps__thread reveal" aria-hidden="true"></span>
      {
        s.home.build.steps.map((step, i) => (
          <li class="steps__item reveal">
            <span class="steps__node">
              <Icon name={stepIcons[i]} width="28" height="28" aria-hidden="true" />
            </span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="section__link reveal">
      <a class="link-arrow" href={`${base}/how-it-works/`}>
        <span>{s.home.build.link}</span>
        <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

<!-- 4. What a fit looks like. The peak, and the one place the site shows a
     judgement, so no mascot appears anywhere near it. -->
<section class="section">
  <div class="container example">
    <div class="section__head reveal">
      <p class="eyebrow">{s.home.openEdge.eyebrow}</p>
      <h2 class="section__heading">{s.home.openEdge.heading}</h2>
    </div>
    <p class="example__intro reveal">{s.home.openEdge.body}</p>

    <div class="tcard reveal">
      <p class="tcard__label">{s.home.openEdge.roleLabel}</p>
      <ul class="fitlist">
        {
          s.home.openEdge.pieces.map((piece) => (
            <li class:list={['fitlist__row', piece.state === 'open' && 'fitlist__row--open']}>
              <span class="fitlist__name"><bdi>{piece.name}</bdi></span>
              {piece.state === 'set' ? (
                <span class="fitlist__state fitlist__state--held">
                  <Icon name="ph:check" width="14" height="14" aria-hidden="true" />
                  {s.home.openEdge.setLabel}
                </span>
              ) : (
                <span class="fitlist__state fitlist__state--open">
                  <Icon name="ph:minus" width="14" height="14" aria-hidden="true" />
                  {s.home.openEdge.openLabel}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    <p class="example__note">{s.home.openEdge.note}</p>

    {/* The real screen, beside the explanation of it. A marketing page that
        describes a product without showing it is asking to be taken on faith,
        which is the opposite of what this one is arguing. */}
    <Shot
      name="dashboard"
      alt={s.home.build.steps[0].body}
      class="example__shot reveal"
    />
  </div>
</section>

<!-- 6. FAQ. Hud may idle here; it is not an evidence surface. -->
<section class="section">
  <div class="container faq__grid">
    <div class="faq__main">
      <div class="section__head reveal">
        <p class="eyebrow">{s.home.faq.eyebrow}</p>
        <h2 class="section__heading">{s.home.faq.heading}</h2>
      </div>
      <div class="faq__list">
        {
          s.home.faq.items.map((item) => (
            <details class="faq-item reveal">
              <summary>
                <span>{item.q}</span>
                <Icon class="faq-item__chevron" name="ph:caret-down" width="20" height="20" aria-hidden="true" />
              </summary>
              <p class="faq-item__body">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- 7. Closing call to action. Hud waves. One button. -->
<section class="section section--closing">
  <div class="container">
    <div class="closing reveal">
      <div class="closing__bg" aria-hidden="true"></div>
      <Hud pose="waving" size="md" loop />
      <h2>{s.home.closing.heading}</h2>
      <p class="closing__body">{s.home.closing.body}</p>
      <a class="button button--primary button--arrow" href={`${base}/signup/`}>
        <span>{s.actions.signup}</span>
        <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  /* The pain sits under the promise it answers, quieter than the sub above it
     so the reading order stays heading -> promise -> pain -> action. */
  .hero__pain {
    margin-block-start: var(--space-4);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    max-inline-size: 44ch;
  }

  /* The product screen is wide; it gets the full measure rather than being
     squeezed beside the card that explains it. */
  .example__shot {
    margin-block-start: var(--space-10);
    max-inline-size: 56rem;
  }

  /* ---- The pain ----
     One statement, not a card grid. The copy here was cut to a single line, and
     three cards holding one sentence between them would be a grid kept for its
     own sake. */
  .pain__body {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-inline-size: 46ch;
  }

  /* ---- The fit list ----
     Five things a role asks for, and whether this person has them. A held row
     and a missing row differ in weight, icon AND label, never in colour alone,
     and a missing row is deliberately the quieter of the two: the page leads
     with what someone already has. */
  .fitlist {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .fitlist__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-border);
  }

  .fitlist__row:last-child {
    border-block-end: none;
    padding-block-end: 0;
  }

  .fitlist__name {
    font-weight: var(--weight-medium);
  }

  .fitlist__row--open .fitlist__name {
    color: var(--color-text-muted);
  }

  .fitlist__state {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  /* Not --color-accent: gold is a fill here, and as text on paper it measures
     below AA. --color-accent-ink is the derived tone that passes. */
  .fitlist__state--held {
    color: var(--color-accent-ink);
  }

  .fitlist__state--open {
    color: var(--color-text-muted);
  }

  .closing__body {
    color: var(--color-text-muted);
    max-inline-size: 32ch;
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding-block: var(--space-20) var(--space-16);
    /* Clip only the horizontal bleed (which would add a scrollbar); let the glow
       fade downward past the section instead of hitting the hard rectangular
       edge `overflow: hidden` gave it. */
    overflow-x: clip;
    isolation: isolate;

    /* Which way the light leans. Both glow layers are tilted, and a tilt is
       the one thing a logical property cannot mirror for us: `inset-inline-end`
       moves the shape to the other corner in Arabic but leaves it leaning the
       same way, which reads as light coming from the wrong place. Every angle
       below is multiplied by this, so the whole composition mirrors with the
       page instead of only its position. */
    --glow-lean: 1;
  }

  :global([dir='rtl']) .hero {
    --glow-lean: -1;
  }

  /* THE HERO LIGHT
     ---------------------------------------------------------------------
     A single large light source bleeding in from the corner the mascot
     stands in, breathing slowly. It is anchored to the SECTION's inline-end
     edge, not to the mascot, because the shape being drawn is light entering
     the page rather than a halo around a figure — a glow that stays centred
     on him reads as a sticker no matter how soft it is.

     Logical properties, so it is the right corner in English and the left in
     Arabic. Both are the corner Hud stands in, because he sits at the
     inline-end of the hero grid in either direction. That is the whole reason
     it keeps working when the page flips.

     Two stacked layers: a wide field and a tighter, brighter core. One gradient
     either reads as a flat disc or blows out its middle; two give a falloff that
     looks like light. Both are ELLIPSES — a circle at this size reads as a
     spotlight aimed at the page, and the reference is a shaft of light entering
     it.

     SIZE, BRIGHTNESS AND MOTION were all dialled up after two passes read as
     "too small, barely moving, and only shows on the dark theme":

      - The centre is kept mostly ON screen now, not hung off the corner. A
        blurred blob whose centre is off-screen barely appears to move when you
        translate it — only its faint outer edge sweeps. Bringing the bright
        middle into view is what makes the same motion actually visible, and is
        most of why the earlier version looked static.
      - Brightness is roughly doubled (peak core ~55% accent, not ~34% behind
        0.45 opacity). At the old value it was a faint tint that vanished on the
        paper theme and only registered against dark navy — which is why it
        seemed to appear "in Arabic only" when Arabic happened to be in dark
        mode. It now clears both themes.
      - The swing is large and unmistakable: the core goes 0.4 -> 1 opacity and
        0.75 -> 1.35 scale while drifting and rotating ~32deg.

     SMOOTHNESS COMES FROM THE LOOP SHAPE, not the easing curve. A multi-keyframe
     loop decelerates to a full stop at EVERY keyframe, and those repeated stops
     are what read as stutter however gentle the curve is. So each layer is two
     keyframes on `alternate` instead: velocity now rests only at the two
     extremes, which is exactly where a breath pauses. The core's full there-and
     -back swing is 2.5s x 2 = 5s. The field runs at 3.25s (6.5s round trip) so
     the pair drifts in and out of phase and never looks mechanically locked,
     while the core still sets the ~5s rhythm the eye actually reads.

     Easing is `--ease-in-out` per itqan-motion's decision table: this is an
     element already on screen, morphing in place.

     Three details that are load-bearing rather than decorative:

      - Every stop ends on the accent at ZERO alpha, never the `transparent`
        keyword. `transparent` is transparent BLACK, and an engine that
        interpolates without premultiplying drags the midtones toward grey,
        which is what a glow with a dirty ring around it is.
      - `filter: blur()` on each layer smooths the gradient's alpha steps, which
        band into visible rings on WebKit because it does not dither them. Held
        at the 20px ceiling itqan-motion sets for animated layers; the extra
        gradient stops do the rest of the softening that a wider blur was doing.
      - Only transform and opacity animate, so both layers stay on the
        compositor and neither triggers layout or paint however far they travel.
        `translate3d` in the keyframes promotes the layer without a standing
        `will-change`, which the skill asks be temporary rather than permanent.
     --------------------------------------------------------------------- */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
    border-radius: var(--radius-full);
  }

  /* Outer field: broad, filling the inline-end half of the hero and reaching
     well into the middle so the light has somewhere to fall off to. */
  .hero::before {
    inline-size: min(130vw, 62rem);
    aspect-ratio: 1 / 1.15;
    inset-block-start: -20%;
    inset-inline-end: -12%;
    background: radial-gradient(
      closest-side at 50% 50%,
      color-mix(in srgb, var(--color-accent) 22%, transparent) 0%,
      color-mix(in srgb, var(--color-accent) 14%, transparent) 30%,
      color-mix(in srgb, var(--color-accent) 7%, transparent) 52%,
      color-mix(in srgb, var(--color-accent) 3%, transparent) 68%,
      color-mix(in srgb, var(--color-accent) 0%, transparent) 86%
    );
    filter: blur(20px);
    /* Base pose, used as-is when motion is reduced. */
    transform: rotate(calc(var(--glow-lean) * -8deg)) scale(1.02);
    animation: glow-field 3.25s var(--ease-in-out) infinite alternate;
  }

  /* The core: brighter, its centre sitting just inside the inline-end edge at
     mid height, where the reference light is strongest. This is the layer the
     eye registers as "something is happening over there", and the one that sets
     the 5s rhythm. */
  .hero::after {
    inline-size: min(92vw, 42rem);
    aspect-ratio: 1 / 1.3;
    inset-block-start: 0%;
    inset-inline-end: -4%;
    background: radial-gradient(
      closest-side at 50% 50%,
      color-mix(in srgb, var(--color-accent) 30%, transparent) 0%,
      color-mix(in srgb, var(--color-accent) 18%, transparent) 30%,
      color-mix(in srgb, var(--color-accent) 8%, transparent) 52%,
      color-mix(in srgb, var(--color-accent) 3%, transparent) 68%,
      color-mix(in srgb, var(--color-accent) 0%, transparent) 84%
    );
    filter: blur(20px);
    transform: rotate(calc(var(--glow-lean) * -10deg)) scale(1);
    animation: glow-core 2.5s var(--ease-in-out) infinite alternate;
  }

  /* Two keyframes each, on `alternate`. Each angle and inline offset is
     multiplied by --glow-lean so the whole thing mirrors in Arabic instead of
     leaning the wrong way out of the opposite corner. */
  @keyframes glow-field {
    from {
      transform: translate3d(calc(var(--glow-lean) * 5%), -4%, 0) rotate(calc(var(--glow-lean) * -21deg)) scale(0.86);
      opacity: 0.55;
    }
    to {
      transform: translate3d(calc(var(--glow-lean) * -8%), 6%, 0) rotate(calc(var(--glow-lean) * 4deg)) scale(1.2);
      opacity: 1;
    }
  }

  @keyframes glow-core {
    from {
      transform: translate3d(calc(var(--glow-lean) * 6%), -5%, 0) rotate(calc(var(--glow-lean) * -26deg)) scale(0.75);
      opacity: 0.4;
    }
    to {
      transform: translate3d(calc(var(--glow-lean) * -9%), 8%, 0) rotate(calc(var(--glow-lean) * 6deg)) scale(1.35);
      opacity: 1;
    }
  }

  /* Reduced motion is not NO motion (itqan-motion §5): movement goes, the fade
     stays. An opacity breathe does not trigger vestibular symptoms, and killing
     the light's life entirely was overcorrecting — it left a flat gold smear
     where a light source should be.

     Only the animation NAME and duration are overridden, so the shorthand's
     `infinite alternate` still applies and the base `transform` on each layer
     holds its pose. */
  @media (prefers-reduced-motion: reduce) {
    .hero::before,
    .hero::after {
      animation-name: glow-fade;
      animation-duration: 6s;
    }

    @keyframes glow-fade {
      from { opacity: 0.6; }
      to   { opacity: 1; }
    }
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .hero__copy {
    flex: 1 1 32rem;
  }

  /* Size is fluid and lives in global.css beside the other display headings, so
     the hero and the interior page heads scale on one curve. */
  .hero__title {
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    max-inline-size: 20ch;
  }

  /* The drawn gold rule: a short thread that wipes in under the headline. */
  .hero__rule {
    margin-block-start: var(--space-6);
    inline-size: var(--space-16);
    block-size: 4px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    transform: scaleX(1);
    transform-origin: 0 50%;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global([dir='rtl']) .hero__rule {
    transform-origin: 100% 50%;
  }

  :global(html.reveal-ready) .hero__rule.reveal:not(.is-visible) {
    transform: scaleX(0);
  }

  .hero__sub {
    margin-block-start: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-inline-size: 52ch;
  }

  .hero__actions {
    margin-block-start: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__figure {
    flex: 0 0 auto;
    position: relative;
  }

  @media (max-width: 51.99rem) {
    /* The homepage is the first thing anyone sees, and on a phone the mascot
       plus his glow filled most of the first screen before a word was read.
       He is removed from the hero here — homepage only, phone only. He stays
       on desktop, on every other page, and in the closing section below, which
       is the one place on this page where he is the invitation rather than
       decoration. Removed from the flow rather than hidden, so his video is
       never fetched on a phone connection either. */
    .hero__figure {
      display: none;
    }

    .hero {
      padding-block: var(--space-12) var(--space-10);
    }
    .hero__grid {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-8);
    }
  }

  /* ---- Sections ----
     .section, .section--sunken, .section__heading and the whole closing block
     now live in global.css: the about page uses every one of them and a scoped
     rule here never reached it. */
  .section__link {
    margin-block-start: var(--space-10);
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    /* It is a standalone action sitting on its own line, not a link inside a
       sentence, so it takes the 44px touch floor. Measured at 30px before. */
    min-block-size: 44px;
    gap: var(--space-2);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    text-decoration: none;
  }

  .link-arrow .button__arrow {
    color: var(--color-accent-ink);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  :global([dir='rtl']) .link-arrow .button__arrow {
    transform: scaleX(-1);
  }

  .link-arrow:hover .button__arrow {
    transform: translateX(3px);
  }

  :global([dir='rtl']) .link-arrow:hover .button__arrow {
    transform: scaleX(-1) translateX(3px);
  }

  /* ---- Cards ---- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 51.99rem) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
  }

  /* The `.reveal` in the selector is load-bearing, not decoration.
     `html.reveal-ready .reveal` in global.css sets `transition: opacity,
     transform` and outweighs a plain `.card` rule, so the hover lift inherited
     the reveal's 300ms while box-shadow and border-color were not in the
     property list at all and snapped. Matching on both classes takes the
     specificity back and restores one coherent hover. */
  .card.reveal {
    transition:
      /* opacity is the reveal entrance's own; taking the declaration over means
         carrying it, or the card fades in instantly and only slides. */
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(calc(-4px * var(--motion-scale)));
      box-shadow: var(--shadow-lg);
      border-color: var(--color-border-strong);
    }
  }

  .card h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-block: var(--space-5) var(--space-3);
  }

  .card p {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ---- Steps + the translation thread ---- */
  .steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }

  /* Thread runs across the node centres and draws from the reading-start side. */
  .steps__thread {
    position: absolute;
    inset-block-start: 27px;
    inset-inline: 12.5%;
    block-size: 3px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    transform: scaleX(1);
    transform-origin: 0 50%;
    transition: transform var(--duration-slower) var(--ease-out);
  }

  :global([dir='rtl']) .steps__thread {
    transform-origin: 100% 50%;
  }

  :global(html.reveal-ready) .steps__thread.reveal:not(.is-visible) {
    transform: scaleX(0);
  }

  .steps__item {
    position: relative;
    text-align: center;
  }

  .steps__node {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 56px;
    block-size: 56px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
    box-shadow: 0 0 0 6px var(--color-surface-sunken);
    margin-block-end: var(--space-5);
  }

  .steps__item h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-2);
  }

  .steps__item p {
    color: var(--color-text-muted);
    line-height: 1.6;
    max-inline-size: 34ch;
    margin-inline: auto;
  }

  @media (max-width: 51.99rem) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .steps__thread {
      display: none;
    }
    .steps__item {
      text-align: start;
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: var(--space-5);
      align-items: center;
    }
    .steps__node {
      margin-block-end: 0;
      grid-row: span 2;
    }
    .steps__item p {
      margin-inline: 0;
      grid-column: 2;
    }
  }

  /* ---- Worked example: the translation card ---- */
  .example__intro {
    color: var(--color-text-muted);
    margin-block-end: var(--space-8);
    font-size: var(--text-lg);
    max-inline-size: 46rem;
  }

  .tcard {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
