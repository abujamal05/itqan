---
/**
 * Hud, the mascot. Every appearance on the site goes through this component.
 *
 * Contract: drop files at public/mascot/{pose}.webm and public/mascot/{pose}.png
 * and they are used automatically. No page changes needed. Until then a
 * labelled box renders at the same aspect ratio.
 *
 * Rules enforced here (from the brand skill):
 * - decoration only: aria-hidden, empty alt, never the only carrier of meaning
 * - never below 120px wide
 * - reduced motion gets the poster image and never loads the video
 * - videos play only in the viewport, pause outside it
 */
import fs from 'node:fs';
import path from 'node:path';

export type HudPose = 'flying-in' | 'idle' | 'waving' | 'thinking' | 'analyzing' | 'error';

interface Props {
  pose: HudPose;
  /** Pose to hand over to after a play-once pose finishes (e.g. flying-in to idle). */
  then?: HudPose;
  size?: 'sm' | 'md' | 'lg';
  /** Loops while in view. Play-once poses omit it. */
  loop?: boolean;
  /** Above the fold: start loading immediately instead of lazily. */
  eager?: boolean;
}

const { pose, then: nextPose, size = 'md', loop = false, eager = false } = Astro.props;

const mascotDir = path.join(process.cwd(), 'public', 'mascot');
const exists = (file: string) => fs.existsSync(path.join(mascotDir, file));

const video = exists(`${pose}.webm`) ? `/mascot/${pose}.webm` : null;
const poster = exists(`${pose}.png`) ? `/mascot/${pose}.png` : null;
const nextVideo = nextPose && exists(`${nextPose}.webm`) ? `/mascot/${nextPose}.webm` : null;

/**
 * Fluid, not fixed. A single px width made him oversized on a 360px phone and
 * undersized on a 27in monitor, and the still fallback showed it worst because
 * a frozen figure is looked at rather than glanced at. Each size is a range:
 * a floor that keeps him above the 120px where he becomes noise, a viewport
 * term so he tracks the layout, and a ceiling so he never dominates.
 * `aspect-ratio` on .hud holds the proportions at every step of that range.
 */
const widths = {
  sm: 'clamp(120px, 16vw, 140px)',
  md: 'clamp(140px, 22vw, 180px)',
  lg: 'clamp(160px, 30vw, 250px)',
};
const width = widths[size];
---

{
  video ? (
    <div class="hud" style={`--hud-width: ${width}`} aria-hidden="true">
      <video
        class="hud__video"
        muted
        playsinline
        autoplay
        loop={loop}
        poster={poster ?? undefined}
        preload="none"
        width="400"
        height="386"
        data-src={video}
        data-next-src={nextVideo ?? undefined}
        data-eager={eager ? 'true' : undefined}
      ></video>
    </div>
  ) : poster ? (
    <div class="hud" style={`--hud-width: ${width}`} aria-hidden="true">
      <img
        class="hud__poster"
        src={poster}
        alt=""
        width="400"
        height="386"
        decoding="async"
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>
  ) : (
    <div class="hud hud--placeholder" style={`--hud-width: ${width}`} aria-hidden="true">
      <span class="hud__pose-name">Hud</span>
      <span class="hud__pose-file">{pose}{nextPose ? ` + ${nextPose}` : ''}</span>
      <span class="hud__pose-hint">/mascot/{pose}.webm</span>
    </div>
  )
}

<script>
  /**
   * Decide whether the mascot can animate CORRECTLY here, and show the still
   * PNG whenever the answer is no. A clean still beats a broken animation, and
   * the page must never be the thing that decides that on the user's behalf by
   * guessing wrong.
   *
   * Three separate failures are handled, because they are three different
   * bugs and only the first is about the browser's name:
   *
   *  1. WEBM ALPHA IS DISCARDED. WebKit decodes the file and throws the alpha
   *     channel away, painting every transparent pixel solid black — a black
   *     rectangle where the bird should be. That is every browser on iPhone and
   *     iPad (all WebKit underneath) plus Safari on the Mac. There is no
   *     feature query for it, so the engine is identified up front and the
   *     video is never requested at all. Skipping the request is the point:
   *     the clips are 220-470KB and downloading one on a phone to discover it
   *     cannot be used is the worst of both.
   *
   *  2. PLAYBACK NEVER STARTS. Low Power Mode on iOS, a data saver, or a
   *     refused autoplay leaves a video element that loaded fine and simply
   *     never moves. Checked by watching the clock rather than trusting
   *     play() to resolve.
   *
   *  3. ALPHA IS DISCARDED SOMEWHERE ELSE. Read back from the first painted
   *     frame, so any engine that regresses degrades to the still instead of
   *     showing a black box. Free, because the frame is already decoded.
   *
   * The real fix for (1) is shipping an HEVC-with-alpha companion file, which
   * needs the source animations re-exported.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videos = document.querySelectorAll<HTMLVideoElement>('.hud__video');

  /**
   * Every WebKit browser reports Apple as the vendor, on every platform, and
   * nothing else does — Chrome and Edge say "Google Inc.", Firefox says "".
   * That covers Safari, and Chrome/Firefox/Edge on iOS, which are WebKit in a
   * different coat and were the ones the old user-agent regex let through.
   */
  const isWebKit = navigator.vendor === 'Apple Computer, Inc.';

  /** Swaps a video for its poster, in place, keeping the layout box identical. */
  const toStill = (video: HTMLVideoElement) => {
    const poster = video.getAttribute('poster');
    if (!poster || !video.parentNode) return;
    const img = document.createElement('img');
    img.className = 'hud__poster';
    img.src = poster;
    img.alt = '';
    img.width = 400;
    img.height = 386;
    img.decoding = 'async';
    img.loading = video.dataset.eager ? 'eager' : 'lazy';
    video.replaceWith(img);
  };

  /**
   * True when the painted frame still has transparent corners. The artwork is
   * centred in a 400x386 frame, so all four corners are empty; if they come
   * back opaque the alpha channel was dropped on the way in.
   */
  const keptAlpha = (video: HTMLVideoElement) => {
    try {
      const c = document.createElement('canvas');
      c.width = 8;
      c.height = 8;
      const ctx = c.getContext('2d', { willReadFrequently: true });
      if (!ctx) return true;                 // cannot tell; assume it is fine
      ctx.drawImage(video, 0, 0, 8, 8);
      const { data } = ctx.getImageData(0, 0, 8, 8);
      const corners = [0, 7, 56, 63].map((px) => data[px * 4 + 3]);
      return Math.min(...corners) < 250;
    } catch {
      return true;                           // never fail closed on a probe
    }
  };

  videos.forEach((video) => {
    if (isWebKit || reduced.matches) {
      // Reduced motion gets the still for the same reason, and neither case
      // ever requests the clip.
      toStill(video);
      return;
    }

    let verified = false;

    const load = () => {
      if (!video.src && video.dataset.src) {
        video.src = video.dataset.src;
        // Buffer the whole clip. With preload="none" a looping video can stall
        // at the wrap point while it re-reads the start, which reads as the
        // animation pausing before it restarts.
        video.preload = 'auto';
      }
    };

    /**
     * Once playback reports it has started: has the clock actually moved, and
     * did the frame keep its alpha. Either answer being no means the still is
     * the better mascot.
     *
     * Finding it PAUSED at the end of the window is not a failure — that is the
     * observer below doing its job because the user scrolled him out of view.
     * Falling back on that would take the animation away from anyone who
     * scrolls quickly, so the check simply re-arms for the next time he plays.
     */
    const verify = () => {
      if (verified) return;
      verified = true;
      const at = video.currentTime;
      window.setTimeout(() => {
        if (!video.isConnected) return;
        if (video.paused) { verified = false; return; }
        if (video.currentTime === at || !keptAlpha(video)) toStill(video);
      }, 600);
    };

    video.addEventListener('playing', verify);
    // Nothing to play back means nothing to verify.
    video.addEventListener('error', () => toStill(video), { once: true });

    if (video.dataset.eager) load();

    if (!('IntersectionObserver' in window)) {
      load();
      video.play().catch(() => toStill(video));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            load();
            video.play().catch(() => toStill(video));
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '120px' }
    );
    io.observe(video);

    // Play-once poses hand over to the next pose when they finish.
    video.addEventListener('ended', () => {
      const next = video.dataset.nextSrc;
      if (next) {
        video.preload = 'auto';
        video.src = next;
        video.loop = true;
        video.play().catch(() => {});
      }
    });
  });
</script>

<style>
  .hud {
    position: relative;
    inline-size: var(--hud-width);
    min-inline-size: 120px; /* below this he becomes visual noise */
    aspect-ratio: 400 / 386;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* GLOBAL on purpose, not scoped. The WebKit fallback poster is created in the
   * script above with `document.createElement('img')`, so it never carries the
   * `data-astro-cid` hash Astro adds to markup — a scoped `.hud__poster` rule
   * would silently skip the one element WebKit always renders. Left scoped, that
   * poster fell back to the browser defaults `object-fit: fill` and
   * `min-block-size: auto`, which STRETCHED the mascot art into a 250x386 box.
   * The image on the page is exactly the case these rules must reach. */
  :global(.hud__video),
  :global(.hud__poster) {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    /* Let the media shrink below its intrinsic 400x386 so the container's
       aspect-ratio drives the box. Without it the flex item's automatic
       minimum is its intrinsic height and the box grows to 386px tall. */
    min-inline-size: 0;
    min-block-size: 0;
  }

  /* The contact shadow.
   *
   * It is a separate painted element, not another `drop-shadow()` on the
   * artwork, and that is the whole point. Filters on a composited layer are
   * rasterised at the layer's resolution, which on iOS is often lower than the
   * page's, so a shadow drawn that way arrives with visible steps in it while
   * the same rule looks smooth on a desktop GPU. A blurred gradient is drawn by
   * the same painter as everything else and lands identically on both.
   *
   * The stops end on navy at zero alpha rather than the `transparent` keyword.
   * `transparent` is transparent BLACK, and an engine that interpolates without
   * premultiplying darkens the midpoint into a grey ring on the way out.
   */
  .hud::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset-inline: 8%;
    inset-block-end: 2%;
    block-size: 22%;
    border-radius: var(--radius-full);
    pointer-events: none;
    background: radial-gradient(
      50% 50% at 50% 50%,
      color-mix(in srgb, var(--navy) 24%, transparent) 0%,
      color-mix(in srgb, var(--navy) 13%, transparent) 45%,
      color-mix(in srgb, var(--navy) 4%, transparent) 74%,
      color-mix(in srgb, var(--navy) 0%, transparent) 100%
    );
    filter: blur(5px);
  }

  /* On the dark canvas a navy shadow is invisible against navy, so it inverts
     to the same soft pool in the surface colour instead of disappearing. */
  :global([data-theme='dark']) .hud::before {
    background: radial-gradient(
      50% 50% at 50% 50%,
      color-mix(in srgb, var(--navy-950) 55%, transparent) 0%,
      color-mix(in srgb, var(--navy-950) 30%, transparent) 45%,
      color-mix(in srgb, var(--navy-950) 9%, transparent) 74%,
      color-mix(in srgb, var(--navy-950) 0%, transparent) 100%
    );
  }

  /* Two jobs, one filter.
   *
   * 1. ASSET BUG WORKAROUND. The mascot artwork has fully transparent holes
   *    punched through it at the eyes — measured: alpha 0 right beside an
   *    opaque navy pupil. Whatever sits behind the mascot therefore shows
   *    through the eye. On paper that reads as a white highlight and looks
   *    correct, which is why nobody noticed; on the dark canvas the eye turns
   *    black, and behind the hero glow it would take the glow's colour.
   *    A blurred paper-coloured drop-shadow is drawn behind the alpha, so it
   *    floods those holes with paper in every theme and the eye reads right
   *    wherever he stands. 3px is the measured minimum that fills the hole
   *    completely; 1px only reached 188,188,189 (grey).
   *
   * 2. Keyline. On dark surfaces his navy parts would otherwise merge into the
   *    canvas, and the same shadow gives him a hairline cream edge.
   *
   * THE REAL FIX IS IN THE ARTWORK: re-export the mascot with the eyes painted
   * opaque instead of cut out. Then this can drop back to a 1px keyline under
   * [data-theme='dark'] only. Kept out of the video file so one clean asset
   * still serves both themes.
   *
   * Two passes, not three. One 3px pass is what the measurement showed fills
   * the hole; the third was insurance, and on a phone each pass is another
   * full-layer rasterisation of a 400px figure that is often the only animated
   * thing on screen. The visible result is identical and it is a third cheaper.
   */
  :global(.hud__video),
  :global(.hud__poster) {
    filter: drop-shadow(0 0 3px var(--paper)) drop-shadow(0 0 3px var(--paper));
  }

  .hud--placeholder {
    flex-direction: column;
    gap: var(--space-1);
    background-color: var(--color-surface-sunken);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-align: center;
  }

  .hud__pose-name {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .hud__pose-file {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .hud__pose-hint {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    direction: ltr;
  }
</style>
