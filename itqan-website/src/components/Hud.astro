---
/**
 * Hud, the mascot. Every appearance on the site goes through this component.
 *
 * Contract: drop files at public/mascot/{pose}.webm and public/mascot/{pose}.png
 * and they are used automatically. No page changes needed. Until then a
 * labelled box renders at the same aspect ratio.
 *
 * Rules enforced here (from the brand skill):
 * - decoration only: aria-hidden, empty alt, never the only carrier of meaning
 * - never below 120px wide
 * - reduced motion gets the poster image and never loads the video
 * - videos play only in the viewport, pause outside it
 */
import fs from 'node:fs';
import path from 'node:path';

export type HudPose = 'flying-in' | 'idle' | 'waving' | 'thinking' | 'analyzing' | 'error';

interface Props {
  pose: HudPose;
  /** Pose to hand over to after a play-once pose finishes (e.g. flying-in to idle). */
  then?: HudPose;
  size?: 'sm' | 'md' | 'lg';
  /** Loops while in view. Play-once poses omit it. */
  loop?: boolean;
  /** Above the fold: start loading immediately instead of lazily. */
  eager?: boolean;
}

const { pose, then: nextPose, size = 'md', loop = false, eager = false } = Astro.props;

const mascotDir = path.join(process.cwd(), 'public', 'mascot');
const exists = (file: string) => fs.existsSync(path.join(mascotDir, file));

const video = exists(`${pose}.webm`) ? `/mascot/${pose}.webm` : null;
const poster = exists(`${pose}.png`) ? `/mascot/${pose}.png` : null;
const nextVideo = nextPose && exists(`${nextPose}.webm`) ? `/mascot/${nextPose}.webm` : null;

const widths = { sm: '120px', md: '180px', lg: '250px' };
const width = widths[size];
---

{
  video ? (
    <div class="hud" style={`--hud-width: ${width}`} aria-hidden="true">
      <video
        class="hud__video"
        muted
        playsinline
        autoplay
        loop={loop}
        poster={poster ?? undefined}
        preload="none"
        data-src={video}
        data-next-src={nextVideo ?? undefined}
        data-eager={eager ? 'true' : undefined}
      ></video>
    </div>
  ) : poster ? (
    <div class="hud" style={`--hud-width: ${width}`} aria-hidden="true">
      <img
        class="hud__poster"
        src={poster}
        alt=""
        width="400"
        height="386"
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>
  ) : (
    <div class="hud hud--placeholder" style={`--hud-width: ${width}`} aria-hidden="true">
      <span class="hud__pose-name">Hud</span>
      <span class="hud__pose-file">{pose}{nextPose ? ` + ${nextPose}` : ''}</span>
      <span class="hud__pose-hint">/mascot/{pose}.webm</span>
    </div>
  )
}

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videos = document.querySelectorAll<HTMLVideoElement>('.hud__video');

  /**
   * WebKit decodes WebM but throws the alpha channel away, so every
   * transparent pixel around Hud paints solid black. That is every browser on
   * iPhone and iPad (they are all WebKit underneath) plus Safari on the Mac.
   *
   * There is no feature query for "alpha in WebM", so this is engine
   * detection, which is the honest description of the bug. Those browsers get
   * the transparent PNG instead: a still mascot is a large step better than a
   * black rectangle. The real fix is shipping an HEVC-with-alpha companion
   * file, which needs the source animations re-exported.
   */
  const ua = navigator.userAgent;
  const iOSLike = /iP(hone|od|ad)/.test(ua)
    || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1); // iPadOS reports as Mac
  const desktopSafari = /^((?!chrome|chromium|android|crios|fxios|edgios).)*safari/i.test(ua);
  const noWebmAlpha = iOSLike || desktopSafari;

  if (noWebmAlpha) {
    videos.forEach((video) => {
      const poster = video.getAttribute('poster');
      if (!poster) return;
      const img = document.createElement('img');
      img.className = 'hud__poster';
      img.src = poster;
      img.alt = '';
      img.width = 400;
      img.height = 386;
      img.loading = video.dataset.eager ? 'eager' : 'lazy';
      video.replaceWith(img);
    });
  }

  (noWebmAlpha ? [] : videos).forEach((video) => {
    if (reduced.matches) {
      // Poster only. The video file is never requested.
      video.removeAttribute('autoplay');
      video.preload = 'none';
      return;
    }

    const load = () => {
      if (!video.src && video.dataset.src) {
        video.src = video.dataset.src;
        // Buffer the whole clip. With preload="none" a looping video can stall
        // at the wrap point while it re-reads the start, which reads as the
        // animation pausing before it restarts.
        video.preload = 'auto';
      }
    };

    if (video.dataset.eager) load();

    if (!('IntersectionObserver' in window)) {
      load();
      video.play().catch(() => {});
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            load();
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '120px' }
    );
    io.observe(video);

    // Play-once poses hand over to the next pose when they finish.
    video.addEventListener('ended', () => {
      const next = video.dataset.nextSrc;
      if (next) {
        video.preload = 'auto';
        video.src = next;
        video.loop = true;
        video.play().catch(() => {});
      }
    });
  });
</script>

<style>
  .hud {
    inline-size: var(--hud-width);
    min-inline-size: 120px; /* below this he becomes visual noise */
    aspect-ratio: 400 / 386;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hud__video,
  .hud__poster {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  /* Two jobs, one filter.
   *
   * 1. ASSET BUG WORKAROUND. The mascot artwork has fully transparent holes
   *    punched through it at the eyes — measured: alpha 0 right beside an
   *    opaque navy pupil. Whatever sits behind the mascot therefore shows
   *    through the eye. On paper that reads as a white highlight and looks
   *    correct, which is why nobody noticed; on the dark canvas the eye turns
   *    black, and behind the hero glow it would take the glow's colour.
   *    A blurred paper-coloured drop-shadow is drawn behind the alpha, so it
   *    floods those holes with paper in every theme and the eye reads right
   *    wherever he stands. 3px is the measured minimum that fills the hole
   *    completely; 1px only reached 188,188,189 (grey).
   *
   * 2. Keyline. On dark surfaces his navy parts would otherwise merge into the
   *    canvas, and the same shadow gives him a hairline cream edge.
   *
   * THE REAL FIX IS IN THE ARTWORK: re-export the mascot with the eyes painted
   * opaque instead of cut out. Then this can drop back to a 1px keyline under
   * [data-theme='dark'] only. Kept out of the video file so one clean asset
   * still serves both themes.
   */
  .hud__video,
  .hud__poster {
    filter: drop-shadow(0 0 3px var(--paper)) drop-shadow(0 0 3px var(--paper))
      drop-shadow(0 0 3px var(--paper));
  }

  .hud--placeholder {
    flex-direction: column;
    gap: var(--space-1);
    background-color: var(--color-surface-sunken);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-align: center;
  }

  .hud__pose-name {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .hud__pose-file {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .hud__pose-hint {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    direction: ltr;
  }
</style>
