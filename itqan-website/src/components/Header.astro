---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { t, isLocale, defaultLocale, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const strings = t(locale);
const base = `/${locale}`;
const path = Astro.url.pathname;

const links = [
  { href: `${base}/how-it-works/`, label: strings.nav.howItWorks },
  { href: `${base}/proof/`, label: strings.nav.proof },
  { href: `${base}/about/`, label: strings.nav.about },
];

const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '');
---

<header class="site-header">
  <div class="container header-row">
    <!-- Icon-only mark: compact, and it swaps for dark surfaces (brand rule). -->
    <a class="brand" href={`${base}/`} aria-label={strings.a11y.homeLink}>
      <img class="brand-mark brand-mark--light" src="/logos/icon.webp" alt="" width="128" height="141" />
      <img class="brand-mark brand-mark--dark" src="/logos/icon-reversed.webp" alt="" width="128" height="141" />
    </a>

    <nav class="site-nav" id="site-nav" aria-label={strings.a11y.mainNav} data-open="false">
      <ul class="site-nav__list">
        {
          links.map((link) => (
            <li>
              <a
                class="site-nav__link"
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
        <!-- Auth actions live in the menu on mobile; on desktop they move to the
             tools cluster on the right (see .header-tools below). -->
        <li class="site-nav__auth">
          <a class="button button--ghost" href={`${base}/login/`}>{strings.actions.login}</a>
        </li>
        <li class="site-nav__auth">
          <a class="button button--primary button--arrow" href={`${base}/signup/`}>
            <span>{strings.actions.register}</span>
            <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-tools">
      <LangToggle />
      <ThemeToggle />
      <!-- Divider groups utility toggles apart from the account actions. -->
      <span class="header-divider" aria-hidden="true"></span>
      <!-- Auth buttons, after the toggles, on desktop only. -->
      <a class="button button--ghost header-auth" href={`${base}/login/`}>{strings.actions.login}</a>
      <a class="button button--primary button--arrow header-auth" href={`${base}/signup/`}>
        <span>{strings.actions.register}</span>
        <Icon class="button__arrow" name="ph:arrow-right" width="16" height="16" aria-hidden="true" />
      </a>
      <button
        class="icon-button menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-label-open={strings.a11y.menuOpen}
        data-label-close={strings.a11y.menuClose}
        aria-label={strings.a11y.menuOpen}
      >
        <Icon class="menu-button__open" name="ph:list" width="22" height="22" aria-hidden="true" />
        <Icon class="menu-button__close" name="ph:x" width="22" height="22" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const button = header?.querySelector<HTMLButtonElement>('.menu-button');
  const nav = header?.querySelector<HTMLElement>('.site-nav');

  if (button && nav) {
    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      button.setAttribute('aria-expanded', String(open));
      const label = open ? button.dataset.labelClose : button.dataset.labelOpen;
      if (label) button.setAttribute('aria-label', label);
    };

    button.addEventListener('click', () => {
      setOpen(nav.dataset.open !== 'true');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.dataset.open === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    /* Tapping the page behind an open menu closes it. Escape already did, but
       that is the keyboard answer; on a phone the menu covers the content and
       reaching back for the same small button to dismiss it is the fiddliest
       part of the header. Focus leaving the header closes it too, so tabbing
       past the last link does not leave a panel open behind the page. */
    document.addEventListener('pointerdown', (e) => {
      if (nav.dataset.open !== 'true') return;
      if (!header?.contains(e.target as Node)) setOpen(false);
    });

    header?.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (nav.dataset.open !== 'true') return;
        if (!header.contains(document.activeElement)) setOpen(false);
      }, 0);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--color-border);
    view-transition-name: site-header;
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  /* Under about 380px the mark, both language options, the theme toggle and the
     menu button stop fitting on one row with a 16px gap. The gap is what gives
     way, not any of the controls: they are all at the touch floor and shrinking
     one to buy space for another trades a real problem for the same problem. */
  @media (max-width: 24rem) {
    .header-row {
      gap: var(--space-2);
    }

    .header-tools {
      gap: var(--space-1);
    }
  }

  /* Icon mark. Clear space for the icon is 20% of its height; padding covers it. */
  .brand {
    display: inline-flex;
    /* Never shrinks. As an ordinary flex item it did, and at 320px the row ran
       out of room and squeezed the mark down to 8px — a squeezed mark is a
       brand misuse, not a responsive layout. Everything else in the row gives
       way first. */
    flex: 0 0 auto;
    padding: var(--space-1);
    margin-inline-start: calc(-1 * var(--space-1));
    border-radius: var(--radius-sm);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .brand:hover {
    transform: translateY(calc(-1px * var(--motion-scale)));
  }

  .brand-mark {
    width: 40px;
    height: auto;
  }

  .brand-mark--dark {
    display: none;
  }

  :global([data-theme='dark']) .brand-mark--light {
    display: none;
  }

  :global([data-theme='dark']) .brand-mark--dark {
    display: block;
  }

  /* Primary links sit next to the logo; the tools cluster is pushed to the end. */
  .site-nav {
    margin-inline-end: auto;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  /* Animated underline that grows from the inline-start edge on hover/current. */
  .site-nav__link > span {
    position: relative;
  }

  .site-nav__link > span::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: -4px;
    inline-size: 100%;
    block-size: 2px;
    border-radius: var(--radius-full);
    background-color: var(--color-accent);
    transform: scaleX(0);
    /* `transform-origin` takes PHYSICAL positions only — `inline-start` is not
       a valid value, so the declaration was dropped and every underline grew
       from its own centre outwards in both languages. Mirrored by hand below,
       which is the only way to get a logical origin today. */
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  :global([dir='rtl']) .site-nav__link > span::after {
    transform-origin: right;
  }

  .site-nav__link:hover > span::after,
  .site-nav__link[aria-current='page'] > span::after {
    transform: scaleX(1);
  }

  /* The auth items inside the nav are the mobile-menu copies; hidden on desktop. */
  .site-nav__auth {
    display: none;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header-divider {
    inline-size: 1px;
    block-size: var(--space-6);
    background-color: var(--color-border);
    margin-inline: var(--space-1);
  }

  /* 44px, the touch floor, not the 40 it used to be. These only appear at
     52rem and up, which reads as "desktop" and is where the compaction came
     from — but an iPad in landscape is 1024px wide and entirely a touch
     device. There is no width at which a target may be under the floor. */
  .header-auth {
    min-height: 44px;
    padding-block: var(--space-2);
  }

  /* Arrow nudge + RTL mirroring for .button--arrow now lives in global.css so
     it applies to every component's CTA arrow, not only the header. */

  .menu-button {
    display: none;
  }

  .menu-button__close {
    display: none;
  }

  .menu-button[aria-expanded='true'] .menu-button__open {
    display: none;
  }

  .menu-button[aria-expanded='true'] .menu-button__close {
    display: block;
  }

  /* ---- Mobile: collapse links + auth into the menu; keep tools visible ---- */
  @media (max-width: 51.99rem) {
    .menu-button {
      display: inline-flex;
    }

    .header-auth,
    .header-divider {
      display: none;
    }

    /* The panel drops in rather than appearing.
       `display: none` -> `block` gave the one control a thumb uses most on a
       phone no transition at all, while every other control on the site has
       one. `display` is animated with `allow-discrete` so the panel is still
       fully removed from the layout and the tab order when closed — a
       visibility-only hide would leave the links keyboard reachable behind a
       shut menu. Vertical movement only, so it behaves identically in Arabic. */
    .site-nav {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      z-index: var(--z-dropdown);
      margin-inline-end: 0;
      background-color: var(--color-surface);
      border-block-end: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      display: none;
      opacity: 0;
      transform: translateY(calc(-8px * var(--motion-scale)));
      transition:
        opacity var(--duration-fast) var(--ease-out),
        transform var(--duration-fast) var(--ease-out),
        display var(--duration-fast) allow-discrete;
    }

    .site-nav[data-open='true'] {
      display: block;
      opacity: 1;
      transform: none;
      transition-duration: var(--duration-base);
    }

    /* Entry pose, so the panel animates in on the frame it becomes displayed. */
    @starting-style {
      .site-nav[data-open='true'] {
        opacity: 0;
        transform: translateY(calc(-8px * var(--motion-scale)));
      }
    }
    /* No separate reduce override needed: the scalar zeroes the drop and the
       panel simply fades in. */

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-4);
      gap: var(--space-1);
    }

    .site-nav__link {
      width: 100%;
    }

    .site-nav__auth {
      display: block;
    }

    .site-nav__auth:first-of-type {
      margin-block-start: var(--space-3);
      padding-block-start: var(--space-3);
      border-block-start: 1px solid var(--color-border);
    }

    .site-nav__auth .button {
      width: 100%;
    }
  }
</style>
