---
/**
 * One girih tile, drawn with its strap decoration.
 *
 * This is the site's icon system. Every mark is a real tile from the set, so a
 * glyph beside a heading means "this is a piece", and a held tile beside an
 * open one means "you have this, you do not have that" — the meaning is in the
 * state, never in a decorative picture chosen to fill a slot.
 *
 * Meaning never rides on colour alone: a held tile is filled AND its strapwork
 * is closed, an open tile is an outline AND its straps stop at the edge.
 */
import { tile, type TileName } from '../lib/girih';

interface Props {
  name: TileName;
  /** Set tiles are filled with closed strapwork; open tiles are the gap. */
  state?: 'set' | 'open';
  size?: number;
  class?: string;
}

const { name, state = 'set', size = 40, class: className = '' } = Astro.props;
const t = tile(name);
---

<svg
  class:list={['girih-tile', `is-${state}`, className]}
  viewBox={t.viewBox}
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path class="girih-tile__outline" d={t.outline} />
  {
    state === 'set' &&
      t.straps.map((d) => (
        <>
          <path class="girih-tile__gap" d={d} />
          <path class="girih-tile__strap" d={d} />
        </>
      ))
  }
</svg>

<style>
  .girih-tile {
    display: block;
    flex: 0 0 auto;
    overflow: visible;
  }

  .girih-tile__outline {
    fill: var(--tile-fill);
    stroke: var(--tile-edge);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .girih-tile__gap {
    fill: none;
    stroke: var(--tile-fill);
    stroke-width: 5;
  }

  .girih-tile__strap {
    fill: none;
    stroke: var(--tile-strap);
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  /* Set: the piece is held. Filled ground, gold edge, strapwork closed. */
  .is-set {
    --tile-fill: var(--color-accent-tint);
    --tile-edge: var(--color-accent);
    --tile-strap: var(--color-accent-ink);
  }

  /* Open: the piece is missing. Dashed outline, no strapwork at all — the
     shape of what would go here, and visibly nothing in it. */
  .is-open {
    --tile-fill: transparent;
    /* --tile-edge-open lets a dark panel raise the outline without touching the
       set-tile colours; on paper it falls back to the muted ink. */
    --tile-edge: var(--tile-edge-open, var(--color-text-muted));
  }

  .is-open .girih-tile__outline {
    stroke-dasharray: 3 4;
  }
</style>
