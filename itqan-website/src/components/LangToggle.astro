---
import { t, isLocale, defaultLocale, alternatePath, type Locale } from '../i18n';

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const strings = t(locale);
const arHref = alternatePath(Astro.url.pathname, 'ar');
const enHref = alternatePath(Astro.url.pathname, 'en');
---

<!-- Segmented control: both languages shown, active one highlighted. The thumb
     carries a view-transition-name so it glides between the two on navigation
     (in browsers with cross-document view transitions), which is what makes the
     switch feel smooth instead of a hard reload. -->
<div class="lang-switch" role="group" aria-label={strings.a11y.langSwitch} data-active={locale}>
  <span class="lang-switch__thumb" aria-hidden="true"></span>
  <a
    class="lang-switch__opt"
    href={arHref}
    hreflang="ar"
    lang="ar"
    data-lang="ar"
    aria-current={locale === 'ar' ? 'true' : undefined}
  >
    {strings.a11y.langNameAr}
  </a>
  <a
    class="lang-switch__opt"
    href={enHref}
    hreflang="en"
    lang="en"
    data-lang="en"
    aria-current={locale === 'en' ? 'true' : undefined}
  >
    {strings.a11y.langNameEn}
  </a>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.lang-switch__opt').forEach((opt) => {
    opt.addEventListener('click', () => {
      try {
        var chosen = opt.dataset.lang ?? '';
        localStorage.setItem('itqan-lang', chosen);
        /* The app reads this key too, so a choice made here survives the
           crossing into onboarding. */
        localStorage.setItem('itqan.locale', chosen);
        /* And the services answer in whatever the cookie says, so it has to
           move with the toggle or the UI would flip while the data did not. */
        document.cookie = 'itqan_locale=' + chosen + '; Path=/; Max-Age=31536000; SameSite=Lax';
      } catch (e) {
        /* private mode: navigation still works */
      }
    });
  });
</script>

<style>
  .lang-switch {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: var(--space-1);
    padding: 3px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
  }

  .lang-switch__thumb {
    position: absolute;
    z-index: 0;
    inset-block: 3px;
    inline-size: calc(50% - 3px);
    inset-inline-start: 3px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: inset-inline-start var(--duration-base) var(--ease-in-out);
    view-transition-name: lang-thumb;
  }

  .lang-switch[data-active='en'] .lang-switch__thumb {
    inset-inline-start: 50%;
  }

  .lang-switch__opt {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px, the project's touch floor, not the 38 it used to be. This is the
       one control a graduate reading the wrong language needs first, it sits in
       the header where thumbs are least accurate, and it was the only target on
       the site measuring under the floor at every width. */
    min-height: 44px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-hover);
  }

  .lang-switch__opt[aria-current='true'] {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .lang-switch__opt:not([aria-current='true']):hover {
    color: var(--color-text);
  }

  /* Smallest phones. The header row is the mark, both language names, the theme
     toggle and the menu button, and at 320px that stopped fitting once every
     target was raised to the 44px floor — the page gained a horizontal scroll.
     What gives way is this control's padding, not its height and not either
     language name: both languages stay visible in their own script, which is
     the rule that made this a segmented control rather than a dropdown. */
  @media (max-width: 24rem) {
    .lang-switch {
      gap: 0;
    }

    .lang-switch__opt {
      padding-inline: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switch__thumb {
      transition: none;
      view-transition-name: none;
    }
  }
</style>
