---
import { Icon } from 'astro-icon/components';
/** Visible notice for content that is deliberately not final:
    lawyer placeholders, stubs, drafts. */
---

<div class="notice-box" role="note">
  <Icon name="ph:info" width="20" height="20" aria-hidden="true" />
  <div class="notice-box__body">
    <slot />
  </div>
</div>

<style>
  .notice-box {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: var(--color-surface-sunken);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .notice-box svg {
    flex: 0 0 auto;
    margin-block-start: 2px;
    color: var(--color-text-muted);
  }

  .notice-box__body {
    font-weight: var(--weight-medium);
  }
</style>
