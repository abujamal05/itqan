---
import { Icon } from 'astro-icon/components';
/**
 * Confidence badge, per components.md. Colour, icon and word together —
 * the state must read without hue.
 */
import { t, type Locale } from '../i18n';

interface Props {
  kind: 'strong' | 'suggested';
  locale: Locale;
}

const { kind, locale } = Astro.props;
const s = t(locale);
---

{
  kind === 'strong' ? (
    <span class="badge badge--strong">
      <Icon name="ph:check" width="14" height="14" aria-hidden="true" />
      {s.badge.strong}
    </span>
  ) : (
    <span class="badge badge--suggested">
      <Icon name="ph:question" width="14" height="14" aria-hidden="true" />
      {s.badge.suggested}
    </span>
  )
}

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .badge--strong {
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
  }

  .badge--suggested {
    background-color: transparent;
    border: 1px dashed var(--color-border-strong);
    color: var(--color-text-muted);
  }
</style>
