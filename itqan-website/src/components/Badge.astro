---
/**
 * Confidence badge, per components.md. Colour, icon and word together —
 * the state must read without hue.
 */
import { t, type Locale } from '../i18n';

interface Props {
  kind: 'strong' | 'suggested';
  locale: Locale;
}

const { kind, locale } = Astro.props;
const s = t(locale);
---

{
  kind === 'strong' ? (
    <span class="badge badge--strong">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m5 13 4 4L19 7"></path>
      </svg>
      {s.badge.strong}
    </span>
  ) : (
    <span class="badge badge--suggested">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 9a3 3 0 1 1 4.6 2.5c-.9.6-1.6 1.1-1.6 2.5"></path>
        <circle cx="12" cy="18" r="0.5" fill="currentColor"></circle>
      </svg>
      {s.badge.suggested}
    </span>
  )
}

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .badge--strong {
    background-color: var(--color-accent);
    color: var(--color-text-on-gold);
  }

  .badge--suggested {
    background-color: transparent;
    border: 1px dashed var(--color-border-strong);
    color: var(--color-text-muted);
  }
</style>
