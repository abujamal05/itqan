---
/**
 * A girih field: rosettes on a staggered lattice, some set and some open.
 *
 * Held cells carry closed strapwork. Open cells carry only the ghost of the
 * tile that would go there — the visible open edge where the pattern runs out.
 * That difference is the site's whole vocabulary for a gap, so this component
 * is used wherever a surface needs to say "part built" rather than "decorated".
 *
 * The rosette geometry is emitted ONCE into a <defs> and every cell is a <use>
 * of it. Writing full path data per cell put 874KB of duplicated coordinates
 * into the home page; the pattern is identical in every cell, so one definition
 * and a translate per instance says the same thing in a few kilobytes.
 *
 * Rendered to static SVG at build time. No client JavaScript.
 */
import { field, rosette } from '../lib/girih';

interface Props {
  /** Design-space size of the field. The SVG scales to fill its container. */
  width?: number;
  height?: number;
  radius?: number;
  /** Which lattice cells read as set. Defaults to a diagonal front. */
  held?: (row: number, col: number) => boolean;
  /** Lay the tiles in, one after another, as the field enters view. */
  animate?: boolean;
  class?: string;
}

const {
  width = 1400,
  height = 900,
  radius = 96,
  held = (row: number, col: number) => col + row < 5,
  animate = true,
  class: className = '',
} = Astro.props;

const cells = field(width, height, radius, held);

/* Geometry at the origin, instantiated by translate. */
const shape = rosette(radius, 0, 0);

/* Ids must be unique per instance: several fields share one document, and a
   duplicated id would make every later field reference the first one's radius. */
const uid = `girih-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['girih-field', animate && 'is-animated', className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <g id={`${uid}-set`}>
      <path class="girih-frame" d={shape.frame} />
      <path class="girih-core" d={shape.core} />
      {
        /* Each strap is stroked twice: once wide in the ground colour, once
           narrow in the strap colour. Because they are emitted in weave order,
           every crossing resolves as an over/under with no intersection maths. */
        shape.straps.map((d) => (
          <>
            <path class="girih-strap-gap" d={d} />
            <path class="girih-strap" d={d} />
          </>
        ))
      }
    </g>
    <g id={`${uid}-open`}>
      <path class="girih-frame-open" d={shape.frame} />
    </g>
  </defs>

  {
    cells.map((cell) => (
      <use
        href={`#${uid}-${cell.held ? 'set' : 'open'}`}
        class="girih-cell"
        transform={`translate(${cell.cx} ${cell.cy})`}
        style={`--cell-delay: calc(${cell.order * 55}ms * var(--motion-scale))`}
      />
    ))
  }
</svg>

<style>
  .girih-field {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  /* Fills and strokes are set here rather than per element, so a whole field
     re-registers by overriding a handful of custom properties on its container.
     That is how .on-navy flips the pattern without touching this file. */
  .girih-frame {
    fill: var(--girih-tile-fill, transparent);
    stroke: var(--girih-frame, transparent);
    stroke-width: 1;
  }

  .girih-core {
    fill: var(--girih-core, transparent);
    stroke: none;
  }

  .girih-strap-gap {
    fill: none;
    stroke: var(--girih-ground, transparent);
    stroke-width: var(--girih-gap-width, 7);
    stroke-linecap: butt;
  }

  .girih-strap {
    fill: none;
    stroke: var(--girih-strap, transparent);
    stroke-width: var(--girih-strap-width, 2);
    stroke-linecap: round;
  }

  .girih-frame-open {
    fill: none;
    stroke: var(--girih-frame-open, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }

  /* The authored motion: tiles settle into place one after another along the
     lattice diagonal, rather than the whole field fading in as one block. A
     <use> cannot be styled per instance from inside, so the stagger lives on
     the instance itself and moves the tile as a whole — which is what laying a
     tile looks like anyway.

     Movement is expressed through --motion-scale, so reduced motion collapses
     the scale to 1 and the delay to 0 and leaves the fade running at full
     duration. Content is visible by default; .reveal-ready gates the hidden
     state, so a visitor without JavaScript sees the finished pattern. */
  .is-animated .girih-cell {
    transition:
      opacity var(--duration-slower) var(--ease-out) var(--cell-delay),
      transform var(--duration-story) var(--ease-out) var(--cell-delay);
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(html.reveal-ready) :global(.reveal:not(.is-visible)) .is-animated .girih-cell {
    opacity: 0;
    scale: calc(1 - 0.12 * var(--motion-scale));
  }
</style>
