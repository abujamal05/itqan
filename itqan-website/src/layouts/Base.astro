---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, dirFor, isLocale, alternatePath, defaultLocale, locales, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const dir = dirFor(locale);
const strings = t(locale);

const site = Astro.site ?? new URL('https://itqan.example');
const canonical = new URL(Astro.url.pathname, site);
const alternates = locales.map((l) => ({
  hreflang: l,
  href: new URL(alternatePath(Astro.url.pathname, l), site).href,
}));
const xDefault = new URL(alternatePath(Astro.url.pathname, 'ar'), site).href;

const fontHref =
  locale === 'ar'
    ? '/fonts/rubik-arabic-wght-normal.woff2'
    : '/fonts/rubik-latin-wght-normal.woff2';
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* itqan-audit-ignore-start: theme-color meta cannot read a CSS var; these mirror --paper and --navy-950. Update both if those primitives change. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAF8F3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#05091F" />
    {/* itqan-audit-ignore-end */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={strings.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_OM' : 'en_GB'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'ar' ? 'en_GB' : 'ar_OM'}
    />
    {/* og:image is a pending asset — see PLACEHOLDERS.md */}
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href={fontHref} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      /* Theme before first paint: stored choice wins, otherwise the OS setting.
         Follows OS changes live only while no manual choice is stored. */
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('itqan-theme');
        } catch (e) {}
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        document.documentElement.dataset.theme =
          stored || (media.matches ? 'dark' : 'light');
        media.addEventListener('change', function (e) {
          try {
            if (localStorage.getItem('itqan-theme')) return;
          } catch (err) {}
          document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
        });
      })();

      /*
       * Record the language THIS PAGE is in, on every page view.
       *
       * The language toggle wrote these keys, but only when it was clicked —
       * so the preference existed only for people who switched. Someone who
       * arrived on /en/ from a link, read the English site and signed up had
       * nothing stored, and the app fell back to its Arabic default: the
       * language changed under them at exactly the moment they crossed from
       * the site into the product.
       *
       * The page's own locale is the honest signal. It is server rendered into
       * <html lang>, so it is correct before this runs, and reading a page in a
       * language is at least as deliberate as toggling to it.
       *
       * All three keys, because three different readers exist: the root
       * redirect and the 404 read `itqan-lang`, the app reads `itqan.locale`
       * first, and the services answer on the cookie.
       */
      (function () {
        var lang = document.documentElement.lang;
        if (lang !== 'ar' && lang !== 'en') return;
        try {
          localStorage.setItem('itqan-lang', lang);
          localStorage.setItem('itqan.locale', lang);
        } catch (e) {}
        document.cookie =
          'itqan_locale=' + lang + '; Path=/; Max-Age=31536000; SameSite=Lax';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{strings.a11y.skip}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      /* Scroll reveal: vertical only, so it is direction-neutral. Elements are
         visible by default; the class below only hides them once JS is ready.
         No IntersectionObserver means nothing is ever hidden. */
      if ('IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-ready');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
